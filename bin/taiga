#!/usr/bin/env python3
"""taiga — работа с трекером Taiga из папки проекта.

Где лежит токен, решает конфиг проекта (.claude/tracker.local.md, ищется вверх
от текущей папки): ключи token_file / refresh_file. Нет конфига — берутся
общие на пользователя ~/.taiga.{url,token,refresh}.

Секрет в конфиг не пишется никогда — только путь к нему.
"""
import argparse, getpass, json, os, re, shutil, sys, time, pathlib, subprocess, urllib.request, urllib.error

HOME = pathlib.Path.home()
DEF_URL, DEF_TOK, DEF_REF = HOME/".taiga.url", HOME/".taiga.token", HOME/".taiga.refresh"
KINDS = {"us": ("userstories","userstory","userstory-statuses","история"),
         "task": ("tasks","task","task-statuses","задача"),
         "issue": ("issues","issue","issue-statuses","вопрос"),
         "epic": ("epics","epic","epic-statuses","эпик")}
def die(m): print(f"останов: {m}", file=sys.stderr); sys.exit(1)
def ok(m): print(m)

# ── конфиг проекта ───────────────────────────────────────────────────────────
class Conf:
    def __init__(self):
        self.path = self.root = self.slug = None
        self.url_f, self.tok_f, self.ref_f = DEF_URL, DEF_TOK, DEF_REF
        self.base_url = None
        d = pathlib.Path.cwd().resolve()
        for p in [d, *d.parents]:
            f = p/".claude"/"tracker.local.md"
            if f.is_file(): self.path, self.root = f, p; break
        if not self.path: return
        txt = self.path.read_text()
        fm = txt.split("---")[1] if txt.startswith("---") else ""
        def key(k):
            m = re.search(rf"^{k}:\s*(\S+)\s*$", fm, re.M)
            return m.group(1) if m else None
        self.base_url = key("base_url")
        for attr, k in (("tok_f","token_file"), ("ref_f","refresh_file")):
            v = key(k)
            if v: setattr(self, attr, self._resolve(v))
        if key("token_file"):                      # url кладём рядом с токеном
            self.url_f = self.tok_f.with_name(self.tok_f.name.replace("token","url")) \
                         if "token" in self.tok_f.name else self.root/".taiga"/"url"
        m = re.search(r"^\|\s*([a-z0-9][a-z0-9._-]*)\b", txt, re.M)
        self.slug = m.group(1) if m else None
    def _resolve(self, v):
        p = pathlib.Path(os.path.expanduser(v))
        return p if p.is_absolute() else (self.root/p)

C = Conf()

def base():
    if C.base_url: return C.base_url.rstrip("/")
    if C.url_f.is_file(): return C.url_f.read_text().strip().rstrip("/")
    if DEF_URL.is_file(): return DEF_URL.read_text().strip().rstrip("/")
    die("адрес инстанса неизвестен — выполните `taiga login`")

def tok():
    if os.environ.get("TAIGA_TOKEN"): return os.environ["TAIGA_TOKEN"].strip()
    for f in (C.tok_f, DEF_TOK):
        if f.is_file() and f.read_text().strip(): return f.read_text().strip()
    die(f"токена нет ({C.tok_f}) — выполните `taiga login`")

def write_secret(p, v):
    p.parent.mkdir(parents=True, exist_ok=True); os.chmod(p.parent, 0o700)
    t = p.with_suffix(p.suffix+".tmp"); t.write_text(v); os.chmod(t, 0o600)
    t.replace(p); os.chmod(p, 0o600)

def guard_gitignore(d: pathlib.Path):
    """Игнор дописывается ДО записи секрета: иначе окно, в которое попадёт git add -A."""
    try: root = pathlib.Path(subprocess.run(["git","rev-parse","--show-toplevel"], cwd=d,
                 capture_output=True, text=True, check=True).stdout.strip())
    except Exception: return
    gi = root/".gitignore"; line = ".taiga/"
    cur = gi.read_text() if gi.is_file() else ""
    if line not in cur.split():
        gi.write_text(cur + ("" if cur.endswith("\n") or not cur else "\n") + line + "\n")
        ok(f"в {gi} дописано «{line}»")


# ── реестр проектов: слаг → папка с кодом ───────────────────────────────────
# Связь .claude/tracker.local.md односторонняя: папка знает свой проект, а по
# слагу найти папку нельзя. Дозорному и разведке нужна обратная: реестр машинный,
# у каждого свой, заполняется при taiga init.
REG = HOME / ".taiga-kit" / "projects.json"

def reg_load():
    if not REG.is_file(): return {}
    try: d = json.loads(REG.read_text())
    except json.JSONDecodeError: return {}
    return d if isinstance(d, dict) else {}

def reg_save(d):
    REG.parent.mkdir(parents=True, exist_ok=True)
    tmp = REG.with_suffix(".tmp")
    tmp.write_text(json.dumps(d, ensure_ascii=False, indent=2, sort_keys=True) + "\n")
    tmp.replace(REG)

def reg_put(slug, path, base_url):
    d = reg_load()
    d[slug] = {"path": str(pathlib.Path(path).resolve()),
               "base_url": base_url,
               "updated": __import__("datetime").date.today().isoformat()}
    reg_save(d); return d[slug]

def reg_path(slug):
    """Папка проекта или None. Исчезнувшие каталоги не возвращаются."""
    e = reg_load().get(slug)
    if not e: return None
    p = pathlib.Path(e["path"] if isinstance(e, dict) else e)
    return p if p.is_dir() else None

def reg_scan(roots):
    """Обход дерева в поисках .claude/tracker.local.md — для уже подключённых
    проектов, которые заводили до появления реестра."""
    found = []
    for root in roots:
        r = pathlib.Path(os.path.expanduser(root))
        if not r.is_dir(): continue
        for cfg in r.glob("*/**/.claude/tracker.local.md"):
            if any(part in (".git", "node_modules", "Pods", ".build") for part in cfg.parts): continue
            txt = cfg.read_text(errors="ignore")
            m = re.search(r"^\|\s*([a-z0-9][a-z0-9._-]*)\b", txt, re.M)
            u = re.search(r"^base_url:\s*(\S+)\s*$", txt.split("---")[1] if txt.startswith("---") else "", re.M)
            if m: found.append((m.group(1), cfg.parent.parent, u.group(1) if u else ""))
    return found

def cmd_registry(args):
    if args.scan is not None:
        roots = [args.scan] if args.scan else ["~/Development", "~/Documents", "~/Projects", "~/code"]
        ok("ищу подключённые проекты в: " + ", ".join(roots))
        found = reg_scan(roots)
        if not found: ok("ничего не найдено"); return
        d = reg_load(); n = 0
        for slug, path, url in found:
            was = d.get(slug)
            was_path = (was or {}).get("path") if isinstance(was, dict) else was
            if was_path == str(path.resolve()): ok(f"  уже в реестре: {slug}"); continue
            if was_path: ok(f"  ! {slug}: был {was_path}, стал {path}")
            reg_put(slug, path, url or base()); n += 1
            ok(f"  добавлен: {slug:<16} {path}")
        ok(f"\nзаписано: {n}")
        return
    d = reg_load()
    if args.forget:
        if args.forget not in d: die(f"«{args.forget}» в реестре нет")
        del d[args.forget]; reg_save(d); ok(f"удалено: {args.forget}"); return
    if not d: ok(f"реестр пуст ({REG})"); ok("заполняется сам при `taiga init <слаг>` в папке проекта"); return
    ok(f"реестр: {REG}\n")
    gone = []
    for slug in sorted(d):
        e = d[slug]; p = e["path"] if isinstance(e, dict) else e
        live = pathlib.Path(p).is_dir()
        if not live: gone.append(slug)
        cfg = (pathlib.Path(p) / ".claude" / "tracker.local.md").is_file() if live else False
        mark = "" if live and cfg else ("  ← папки нет" if not live else "  ← конфиг трекера пропал")
        ok(f"  {slug:<16} {p}{mark}")
    if gone:
        ok(f"\nисчезло папок: {len(gone)}. Убрать: taiga registry --forget <слаг>")

# ── транспорт ────────────────────────────────────────────────────────────────
def raw(method, path, body=None, token=None, nopage=False, tries=3):
    """Сетевой сбой — не повод терять весь прогон: отчёт делает сотни запросов,
    и один зависший убивал его целиком. Повторяем только сетевые ошибки;
    отказ самого трекера (HTTPError) возвращаем как есть — его разбирает вызвавший.
    Повтор безопасен: GET идемпотентен, а мутации идут с version и дедупликацией."""
    last = None
    for attempt in range(tries):
        r = urllib.request.Request(base()+"/api/v1"+path, method=method,
                                   data=json.dumps(body).encode() if body is not None else None)
        r.add_header("Authorization", "Bearer " + (token or tok()))
        if body is not None: r.add_header("Content-Type", "application/json")
        if nopage: r.add_header("x-disable-pagination", "True")
        try:
            with urllib.request.urlopen(r, timeout=45) as x:
                t = x.read().decode(); return x.status, (json.loads(t) if t.strip() else None)
        except urllib.error.HTTPError as e:
            t = e.read().decode()
            try: return e.code, json.loads(t)
            except Exception: return e.code, t[:300]
        except Exception as e:
            last = e
            if attempt < tries - 1: time.sleep(2 * (attempt + 1))
    die(f"сеть после {tries} попыток: {last}")

def do_refresh(quiet=False):
    f = C.ref_f if C.ref_f.is_file() else DEF_REF
    if not f.is_file(): return False
    req = urllib.request.Request(base()+"/api/v1/auth/refresh",
                                 data=json.dumps({"refresh": f.read_text().strip()}).encode())
    req.add_header("Content-Type","application/json")
    try:
        with urllib.request.urlopen(req, timeout=45) as x: d = json.loads(x.read().decode())
    except Exception: return False
    write_secret(C.tok_f if C.tok_f.is_file() else DEF_TOK, d["auth_token"])
    if d.get("refresh"): write_secret(f, d["refresh"])
    if not quiet: ok("токен обновлён")
    return True

def token_left(which="refresh"):
    """Сколько часов осталось токену. Оба срока сдвигаются при каждом
    обновлении, так что при ежечасных заданиях вход не протухает сам.
    Опасны простои: выключенный на неделю компьютер, отпуск, смена пароля."""
    import base64, datetime
    f = (C.ref_f if which == "refresh" else C.tok_f)
    f = f if f.is_file() else (DEF_REF if which == "refresh" else DEF_TOK)
    try:
        b = f.read_text().strip().split(".")[1]; b += "=" * (-len(b) % 4)
        exp = json.loads(base64.urlsafe_b64decode(b))["exp"]
        return (datetime.datetime.fromtimestamp(exp) - datetime.datetime.now()).total_seconds() / 3600
    except Exception:
        return None

def auth_warn(send=False):
    """Предупредить, пока вход ещё жив. Молчаливый отвал — худшее, что
    может случиться с автоматикой: отчёты просто перестают приходить."""
    h = token_left("refresh")
    if h is None or h > 72: return None
    msg = (f"Вход в Taiga истекает через {int(h)} ч. "
           f"Выполните `taiga login`, иначе отчёты, разведка и уведомления встанут."
           if h > 0 else "Вход в Taiga истёк. Выполните `taiga login`.")
    notify("Taiga: вход скоро истечёт", msg)
    if send:
        rec = cfg_load().get("telegram_recipients", {})
        me = rec.get(str((IDENTITY or {}).get("id")))
        if me: tg_call("sendMessage", {"chat_id": me["chat_id"], "text": "⚠ " + msg})
    return msg

IDENTITY = None
def auth():
    """Канарейка первым вызовом: Taiga на анонимный запрос отвечает 200 и []."""
    global IDENTITY
    if IDENTITY: return IDENTITY
    c, me = raw("GET", "/users/me")
    if c != 200:
        if not do_refresh(): die("токен истёк и refresh не принят — выполните `taiga login`")
        c, me = raw("GET", "/users/me")
        if c != 200: die(f"канарейка {c} после refresh")
    IDENTITY = me; return me

def api(method, path, body=None, nopage=False):
    auth(); return raw(method, path, body, nopage=nopage)

# ── справочники ──────────────────────────────────────────────────────────────
def project(args):
    slug = args.project or C.slug
    if not slug: die("проект не задан: ключ -p <слаг>, или `taiga init <слаг>` в этой папке")
    c, p = api("GET", f"/projects/by_slug?slug={slug}")
    if c != 200: die(f"проект «{slug}» не найден ({c}) — см. `taiga projects`")
    return p

def resolve_status(pid, kind, text):
    c, st = api("GET", f"/{KINDS[kind][2]}?project={pid}"); st = st or []
    hit = [s for s in st if s["name"].lower()==text.lower()] or \
          [s for s in st if text.lower() in s["name"].lower()]
    if not hit: die(f"статус «{text}» не найден. Есть: " + ", ".join(s["name"] for s in st))
    if len(hit) > 1: die(f"«{text}» подходит нескольким: " + ", ".join(s["name"] for s in hit))
    return hit[0]

def resolve_member(pid, text):
    c, ms = api("GET", f"/memberships?project={pid}")
    live = [m for m in (ms or []) if m.get("user")]   # приглашённые (user=null) отбрасываются
    hit = [m for m in live if text.lower() in (m.get("full_name") or "").lower()
           or text.lower() in (m.get("user_email") or "").lower()]
    if not hit: die(f"«{text}» не найден среди участников проекта")
    if len(hit) > 1: die("подходят несколько: " + ", ".join(m["full_name"] for m in hit))
    return hit[0]

def find_item(pid, ref, kind=None):
    ref = int(re.sub(r"\D","",str(ref)))
    for k in ([kind] if kind else ["us","task","issue","epic"]):
        c, d = api("GET", f"/{KINDS[k][0]}/by_ref?ref={ref}&project={pid}")
        if c == 200 and d: return k, d
    die(f"#{ref} не найден в проекте")

def confirm(args, text):
    print(text)
    if args.yes: return True
    if not sys.stdin.isatty(): die("нужно подтверждение, а ввода нет — добавьте -y")
    return input("выполнить? [y/N] ").strip().lower() in ("y","yes","д","да")

# ── команды ──────────────────────────────────────────────────────────────────
def cmd_login(args):
    if not sys.stdin.isatty(): die("логин требует терминала: пароль не берётся из потока")
    cur = None
    for f in (C.url_f, DEF_URL):
        if f.is_file(): cur = f.read_text().strip(); break
    url = input(f"адрес инстанса{f' [{cur}]' if cur else ''}: ").strip() or cur or ""
    if not url: die("адрес не задан")
    url = url.rstrip("/")
    user = input("логин или email: ").strip()
    pw = getpass.getpass("пароль (не отображается): ")
    req = urllib.request.Request(url+"/api/v1/auth",
        data=json.dumps({"type":"normal","username":user,"password":pw}).encode())
    req.add_header("Content-Type","application/json")
    try:
        with urllib.request.urlopen(req, timeout=45) as x: d = json.loads(x.read().decode())
    except urllib.error.HTTPError as e: die(f"логин отклонён: {e.code} (проверьте логин и пароль)")
    if args.here:
        root = pathlib.Path.cwd().resolve()
        guard_gitignore(root)                      # игнор ДО записи секрета
        u,t,r = root/".taiga"/"url", root/".taiga"/"token", root/".taiga"/"refresh"
    else:
        u,t,r = DEF_URL, DEF_TOK, DEF_REF
    write_secret(u,url); write_secret(t,d["auth_token"])
    if d.get("refresh"): write_secret(r,d["refresh"])
    ok(f"вход выполнен: {d.get('full_name_display') or d.get('username')} (id {d['id']})")
    ok(f"токен записан: {t} (права 600)")

def cmd_refresh(args): ok("обновлено" if do_refresh(quiet=True) else "refresh не принят — нужен `taiga login`")

def cmd_status(args):
    me = auth()
    ok(f"инстанс:  {base()}")
    ok(f"личность: {me.get('full_name_display') or me.get('username')} (id {me['id']})")
    ok(f"конфиг:   {C.path or '— не найден в этой папке и выше'}")
    ok(f"проект:   {C.slug or '— не задан'}")
    ok(f"токен:    {C.tok_f if C.tok_f.is_file() else DEF_TOK}")
    h = token_left("refresh")
    if h is not None:
        d, hh = int(h // 24), int(h % 24)
        mark = "" if h > 72 else "  ← пора выполнить `taiga login`"
        ok(f"вход:     действует ещё {d} дн {hh} ч{mark}")
        ok("          срок сдвигается при каждом обращении; опасен только простой")

def cmd_projects(args):
    c, ps = api("GET", "/projects")
    if ps == []: die("список пуст при подтверждённой личности — подозрительно")
    print(f"{'СЛАГ':<22}{'ID':>4}  НАЗВАНИЕ")
    for p in sorted(ps, key=lambda x: x["slug"]): print(f"{p['slug']:<22}{p['id']:>4}  {p['name']}")

def cmd_init(args):
    c, p = api("GET", f"/projects/by_slug?slug={args.slug}")
    if c != 200: die(f"проект «{args.slug}» не найден ({c}) — см. `taiga projects`")
    d = pathlib.Path.cwd()/".claude"; d.mkdir(parents=True, exist_ok=True)
    f = d/"tracker.local.md"
    if f.exists() and not args.force: die(f"{f} уже есть — перезаписать можно с --force")
    tf, rf = (".taiga/token", ".taiga/refresh") if args.here else ("~/.taiga.token","~/.taiga.refresh")
    f.write_text(f"""---
tracker: rest
base_url: {base()}
token_file: {tf}
refresh_file: {rf}
---

# Конфиг трекера

Секретов здесь нет: указан путь к файлу с токеном, а не сам токен.
{'Токен на проект: `.taiga/` в корне, каталог 700, файлы 600, строка в .gitignore.' if args.here else 'Токен общий на пользователя.'}

## Проекты

| Идентификатор | Назначение | Активен | Процесс |
|---|---|---|---|
| {p['slug']} | {args.name or p['name']} (id {p['id']}) | да | канбан |

## Статусы

Не кэшируются: идентификаторы пер-проектные, запрашиваются по факту обращения.

## Связь задачи и работы

- шаблон трейлера коммита: `Задача: #<номер>`
- шаблон идентификатора задачи: `#?(\\d+)`
""")
    ok(f"подключено: {f}")
    ok(f"проект «{p['name']}» (слаг {p['slug']}, id {p['id']})")
    reg_put(p["slug"], pathlib.Path.cwd(), base())
    ok(f"в реестре: {REG}")
    if args.here: ok("токен ожидается в .taiga/ — выполните `taiga login --here` здесь же")

def cmd_ls(args):
    p = project(args); kind = args.kind or "us"
    c, items = api("GET", f"/{KINDS[kind][0]}?project={p['id']}", nopage=True); items = items or []
    # Признак закрытости берётся из КАТАЛОГА статусов, а не из поля объекта:
    # Taiga дублирует is_closed на объект и не пересчитывает его при правке каталога
    # или возврате карточки — проверено, 5.5% объектов инстанса расходятся.
    c, st = api("GET", f"/{KINDS[kind][2]}?project={p['id']}")
    closed_ids = {s["id"] for s in (st or []) if s.get("is_closed")}
    is_closed = lambda i: i["status"] in closed_ids
    if args.open: items = [i for i in items if not is_closed(i)]
    if args.mine: items = [i for i in items if i.get("assigned_to") == IDENTITY["id"]]
    if args.status: items = [i for i in items if args.status.lower() in
                             (i.get("status_extra_info") or {}).get("name","").lower()]
    ok(f"{p['name']} · {KINDS[kind][3]}: {len(items)}")
    for i in sorted(items, key=lambda x: -x["ref"]):
        who = (i.get("assigned_to_extra_info") or {}).get("full_name_display") or "—"
        print(f"  #{i['ref']:<5} [{(i.get('status_extra_info') or {}).get('name','?'):<14}] "
              f"{i['subject'][:56]:<58} {who}")

def cmd_show(args):
    p = project(args); kind, it = find_item(p["id"], args.ref, args.kind)
    c, f = api("GET", f"/{KINDS[kind][0]}/{it['id']}")
    ok(f"#{f['ref']} · {KINDS[kind][3]} · {p['name']}")
    ok(f"  {f['subject']}")
    ok(f"  статус:      {f['status_extra_info']['name']} (закрывающий: {f['status_extra_info'].get('is_closed')})")
    ok(f"  исполнитель: {(f.get('assigned_to_extra_info') or {}).get('full_name_display') or '—'}")
    ok(f"  создана:     {f['created_date'][:10]} · версия {f['version']}")
    if f.get("description"): ok("\n" + f["description"])
    c, h = api("GET", f"/history/{KINDS[kind][1]}/{it['id']}")
    ev = [e for e in (h or []) if "status" in (e.get("values_diff") or {})]
    if ev:
        ok("\n  переходы:")
        for e in reversed(ev):
            v = e["values_diff"]["status"]
            ok(f"    {e['created_at'][:16]}  {(e.get('user') or {}).get('name','?'):<22} {v[0]} → {v[1]}")

def cmd_new(args):
    p = project(args); pid = p["id"]; kind = args.kind or "us"
    if kind == "epic" and not p.get("is_epics_activated"): die("модуль эпиков в проекте выключен")
    body = {"project": pid, "subject": args.subject}
    if kind == "task":
        if not args.parent: die("задача не существует сама по себе — укажите --parent <номер истории>")
        _, par = find_item(pid, args.parent, "us"); body["user_story"] = par["id"]
    if args.assign: body["assigned_to"] = resolve_member(pid, args.assign)["user"]
    if args.status: body["status"] = resolve_status(pid, kind, args.status)["id"]
    if args.desc_file:
        f = pathlib.Path(os.path.expanduser(args.desc_file))
        if not f.is_file(): die(f"файл описания не найден: {f}")
        body["description"] = f.read_text()
    elif args.desc:
        # В одну строку командной строки настоящий перенос не вписать,
        # поэтому \n в тексте разворачиваем в перенос. Длинное описание —
        # через --desc-file, там текст лежит как есть.
        body["description"] = args.desc.replace("\\n", "\n")
    c, ex = api("GET", f"/{KINDS[kind][0]}?project={pid}", nopage=True)
    dup = [i for i in (ex or []) if i["subject"].strip().lower() == args.subject.strip().lower()]
    if dup and not args.force: die(f"уже есть #{dup[0]['ref']} с таким названием — повторить можно с --force")
    what = f"создать {KINDS[kind][3]} в «{p['name']}»: {args.subject}"
    if body.get("description"):
        what += "\n       описание: " + cut(" ".join(body["description"].split()), 140)
    if not confirm(args, what): return
    c, r = api("POST", f"/{KINDS[kind][0]}", body)
    if c != 201: die(f"{c}: {r}")
    ok(f"создано #{r['ref']} (id {r['id']})")

def cmd_mv(args):
    p = project(args); kind, it = find_item(p["id"], args.ref, args.kind)
    st = resolve_status(p["id"], kind, args.status)
    for _ in range(3):
        c, cur = api("GET", f"/{KINDS[kind][0]}/{it['id']}")
        if cur["status"] == st["id"]: ok(f"#{cur['ref']} уже в «{st['name']}»"); return
        if not confirm(args, f"#{cur['ref']} «{cur['subject'][:50]}»: "
                             f"{cur['status_extra_info']['name']} → {st['name']}"): return
        c, r = api("PATCH", f"/{KINDS[kind][0]}/{it['id']}", {"version": cur["version"], "status": st["id"]})
        if c == 200:
            ok(f"#{r['ref']} → {r['status_extra_info']['name']} "
               f"(закрыта: {r['status_extra_info'].get('is_closed')}), версия {cur['version']}→{r['version']}")
            return
        t = json.dumps(r, ensure_ascii=False)
        if "doesn't match" in t: args.yes = True; continue
        if "not valid" in t: die("дефект вызова: версия не принята")
        die(f"{c}: {t}")
    die("конфликт версий не разрешился за 3 попытки")

def cmd_assign(args):
    p = project(args); kind, it = find_item(p["id"], args.ref, args.kind)
    m = resolve_member(p["id"], args.who)
    c, cur = api("GET", f"/{KINDS[kind][0]}/{it['id']}")
    if not confirm(args, f"#{cur['ref']} «{cur['subject'][:50]}» → {m['full_name']}"): return
    c, r = api("PATCH", f"/{KINDS[kind][0]}/{it['id']}", {"version": cur["version"], "assigned_to": m["user"]})
    if c != 200: die(f"{c}: {r}")
    ok(f"#{r['ref']} назначена: {(r.get('assigned_to_extra_info') or {}).get('full_name_display')}")

def cmd_comment(args):
    p = project(args); kind, it = find_item(p["id"], args.ref, args.kind)
    c, h = api("GET", f"/history/{KINDS[kind][1]}/{it['id']}")
    if any((e.get("comment") or "").strip() == args.text.strip() for e in (h or [])) and not args.force:
        die("такой комментарий уже есть — повторить можно с --force")
    c, cur = api("GET", f"/{KINDS[kind][0]}/{it['id']}")
    if not confirm(args, f"#{cur['ref']} комментарий: {args.text[:60]}"): return
    c, r = api("PATCH", f"/{KINDS[kind][0]}/{it['id']}", {"version": cur["version"], "comment": args.text})
    if c != 200: die(f"{c}: {r}")
    ok(f"#{r['ref']} комментарий добавлен")


# ── план: разбор ТЗ применяется файлом, а не чередой команд ──────────────────
def load_plan(path):
    p = pathlib.Path(path)
    if not p.is_file(): die(f"нет файла плана {p}")
    try: d = json.loads(p.read_text())
    except json.JSONDecodeError as e: die(f"план не разбирается как JSON: {e}")
    if not isinstance(d, dict): die("план должен быть объектом JSON")
    return d

def plan_walk(d):
    """Разворачивает план в плоский список (род, предок, элемент)."""
    out = []
    for e in d.get("epics", []):
        out.append(("epic", None, e))
        for s in e.get("stories", []):
            out.append(("us", e, s))
            for t in s.get("tasks", []): out.append(("task", s, t))
    for s in d.get("stories", []):
        out.append(("us", None, s))
        for t in s.get("tasks", []): out.append(("task", s, t))
    return out

def plan_resolve(args, d):
    slug = args.project or d.get("project") or C.slug
    if not slug: die("проект не задан: в плане, ключом -p или через taiga init")
    c, p = api("GET", f"/projects/by_slug?slug={slug}")
    if c != 200: die(f"проект «{slug}» не найден ({c})")
    return p

def plan_index(pid, kind):
    c, items = api("GET", f"/{KINDS[kind][0]}?project={pid}", nopage=True)
    return {i["subject"].strip().lower(): i for i in (items or [])}

def plan_report(args, dry):
    d = load_plan(args.file); p = plan_resolve(args, d); pid = p["id"]
    if d.get("epics") and not p.get("is_epics_activated"):
        die("в плане есть эпики, а модуль эпиков в проекте выключен")
    idx = {k: plan_index(pid, k) for k in ("epic","us","task")}
    rows, n_new = [], 0
    for kind, parent, item in plan_walk(d):
        subj = (item.get("subject") or "").strip()
        if not subj: die("в плане есть элемент без subject")
        have = idx[kind].get(subj.lower())
        rows.append((kind, parent, item, have))
        if not have: n_new += 1
    ok(f"проект: {p['name']} ({p['slug']}, id {pid})")
    ok(f"в плане: {len(rows)}, из них новых: {n_new}, уже есть: {len(rows)-n_new}\n")
    for kind, parent, item, have in rows:
        pad = {"epic":"", "us":"  ", "task":"    "}[kind]
        mark = f"есть #{have['ref']}" if have else "создать"
        ok(f"{pad}[{mark:<10}] {KINDS[kind][3]}: {item['subject'][:58]}")
    return d, p, rows, n_new

def cmd_plan(args): plan_report(args, dry=True); ok("\n(сухой прогон — ничего не записано)")

def cmd_apply(args):
    d, p, rows, n_new = plan_report(args, dry=False)
    if n_new == 0: ok("\nсоздавать нечего — всё уже на месте"); return
    if not confirm(args, f"\nсоздать {n_new} единиц в «{p['name']}»"): return
    pid = p["id"]; made = {}; created = skipped = failed = 0
    for kind, parent, item, have in rows:
        key = (kind, item["subject"].strip().lower())
        if have: made[key] = have; skipped += 1; continue
        body = {"project": pid, "subject": item["subject"]}
        if item.get("description"): body["description"] = item["description"]
        if item.get("assign"):
            body["assigned_to"] = resolve_member(pid, item["assign"])["user"]
        if item.get("status"):
            body["status"] = resolve_status(pid, kind, item["status"])["id"]
        if kind == "task":
            par = made.get(("us", (parent or {}).get("subject","").strip().lower()))
            if not par: ok(f"  ! задача «{item['subject'][:40]}»: родительская история не создана"); failed += 1; continue
            body["user_story"] = par["id"]
        c, r = api("POST", f"/{KINDS[kind][0]}", body)
        if c != 201: ok(f"  ! {item['subject'][:44]} → {c} {r}"); failed += 1; continue
        made[key] = r; created += 1
        ok(f"  #{r['ref']:<5} {KINDS[kind][3]}: {item['subject'][:52]}")
        # привязка истории к эпику отдельным вызовом: поля в теле создания нет
        if kind == "us" and parent:
            ep = made.get(("epic", parent.get("subject","").strip().lower()))
            if ep:
                c2, r2 = api("POST", f"/epics/{ep['id']}/related_userstories",
                             {"epic": ep["id"], "user_story": r["id"]})
                if c2 not in (200, 201): ok(f"        ! связь с эпиком → {c2}")
    ok(f"\nсоздано {created}, пропущено {skipped}, отказов {failed}")


# ── создание проекта ─────────────────────────────────────────────────────────
# Слаг назначает трекер транслитерацией имени — предугадать нельзя, берём из ответа.
# У нового проекта эпики и канбан ВЫКЛЮЧЕНЫ, остальные модули включены. Создание
# в выключенном модуле отвечает 201, поэтому модули включаются ДО единиц работы.
# У проекта нет поля version — правка идёт без цикла с версией.
def copy_columns(pid, sample_slug):
    """Перенос колонок канбана = каталога статусов историй из проекта-образца."""
    c, sp = api("GET", f"/projects/by_slug?slug={sample_slug}")
    if c != 200: die(f"образец «{sample_slug}» не найден ({c})")
    c, src = api("GET", f"/userstory-statuses?project={sp['id']}")
    c, dst = api("GET", f"/userstory-statuses?project={pid}")
    src, dst = src or [], dst or []
    want = {s["name"]: s for s in src}
    have = {s["name"]: s for s in dst}
    made = 0
    for name, s in want.items():                       # сначала создать недостающие
        if name in have: continue
        body = {"project": pid, "name": name, "order": s.get("order", 1),
                "is_closed": s.get("is_closed", False), "is_archived": s.get("is_archived", False)}
        if s.get("color"): body["color"] = s["color"]
        c, r = api("POST", "/userstory-statuses", body)
        if c == 201: have[name] = r; made += 1
        else: ok(f"    ! статус «{name}» → {c} {r}")
    keep = next(iter(have[n]["id"] for n in want if n in have), None)
    if keep is None: die("не удалось создать ни одного статуса образца")
    for name, s in list(have.items()):                 # затем выровнять оставшиеся
        if name in want:
            w = want[name]
            if s.get("order") != w.get("order") or s.get("is_closed") != w.get("is_closed"):
                api("PATCH", f"/userstory-statuses/{s['id']}",
                    {"order": w.get("order", 1), "is_closed": w.get("is_closed", False)})
        else:
            # moveTo обязателен даже в пустом проекте — без него 400
            c, r = api("DELETE", f"/userstory-statuses/{s['id']}?moveTo={keep}")
            if c not in (204, 200): ok(f"    ! удаление «{name}» → {c} {r}")
    c, final = api("GET", f"/userstory-statuses?project={pid}")
    return made, [s["name"] for s in sorted(final or [], key=lambda x: x.get("order", 0))]


def cmd_users(args):
    """Люди инстанса или участники проекта."""
    if args.project or C.slug:
        p = project(args)
        c, ms = api("GET", f"/memberships?project={p['id']}")
        ok(f"участники «{p['name']}»:")
        for m in sorted(ms or [], key=lambda x: (x.get("full_name") or "")):
            mark = "" if m.get("user") else "   ← приглашение, назначить нельзя"
            ok(f"  {(m.get('full_name') or m.get('email')):<26} роль: {m.get('role_name','—'):<16}{mark}")
        c, roles = api("GET", f"/roles?project={p['id']}")
        ok("\nроли проекта: " + ", ".join(r["name"] for r in (roles or [])))
    else:
        c, us = api("GET", "/users")
        ok(f"люди инстанса ({len(us or [])}):")
        for u in sorted(us or [], key=lambda x: (x.get("full_name_display") or "")):
            ok(f"  {u.get('full_name_display'):<26} @{u.get('username'):<18} активен: {u.get('is_active')}")

def add_members(pid, names, role_name, args):
    """Добавление участников. Успешный ответ означает, что письмо УЖЕ ушло."""
    c, roles = api("GET", f"/roles?project={pid}")
    roles = roles or []
    hit = [r for r in roles if r["name"].lower() == (role_name or "").lower()] or \
          [r for r in roles if (role_name or "").lower() in r["name"].lower()]
    if not hit: die(f"роль «{role_name}» не найдена. Есть: " + ", ".join(r["name"] for r in roles))
    if len(hit) > 1: die("подходят несколько ролей: " + ", ".join(r["name"] for r in hit))
    role = hit[0]
    c, all_users = api("GET", "/users")
    # /users почту не отдаёт — только id и username. Почта есть в memberships проектов,
    # а она нужна: по логину Taiga требует, чтобы человек был «контактом».
    emails = {}
    c, projs = api("GET", "/projects")
    for pr in (projs or []):
        c, ms = api("GET", f"/memberships?project={pr['id']}")
        for m in (ms or []):
            if m.get("user") and (m.get("user_email") or m.get("email")):
                emails.setdefault(m["user"], m.get("user_email") or m.get("email"))
    picked = []
    for name in names:
        m = [u for u in (all_users or [])
             if name.lower() in (u.get("full_name_display") or "").lower()
             or name.lower() == (u.get("username") or "").lower()]
        if not m: die(f"«{name}» не найден среди людей инстанса — см. `taiga users`")
        if len(m) > 1: die(f"«{name}» подходит нескольким: " + ", ".join(x["full_name_display"] for x in m))
        u = dict(m[0]); u["email"] = emails.get(u["id"])
        if not u["email"]:
            ok(f"  ! почта для «{u['full_name_display']}» не найдена — пойдём по логину, "
               f"он сработает только если человек делит с вами проект")
        picked.append(u)
    ok(f"\nдобавить в проект с ролью «{role['name']}»:")
    for u in picked: ok(f"  {u['full_name_display']} (@{u['username']})")
    ok("  ВНИМАНИЕ: каждому уйдёт письмо-уведомление. Это действие за пределами трекера.")
    if not confirm(args, ""): ok("участники не добавлены"); return 0
    n = 0
    for u in picked:
        # Поле называется username, но принимает и логин, и почту — и ведут они себя РАЗНО.
        # По логину Taiga требует, чтобы человек был «контактом» (делил с вами проект),
        # иначе 400 «The user must be a valid contact». По почте эта проверка не срабатывает.
        # Поэтому сначала почта, логин — запасной путь. Проверено на живом инстансе.
        r = None
        for ident in [x for x in (u.get("email"), u.get("username")) if x]:
            c, r = api("POST", "/memberships",
                       {"project": pid, "role": role["id"], "username": ident})
            if c == 201: break
        if r and isinstance(r, dict) and r.get("id") and r.get("user"):
            n += 1; ok(f"  добавлен: {u['full_name_display']} (user={r['user']})")
        elif r and isinstance(r, dict) and r.get("id"):
            ok(f"  ! {u['full_name_display']}: создано ПРИГЛАШЕНИЕ (user пустой) — "
               f"назначить на него задачу нельзя, пока не примет")
        else:
            ok(f"  ! {u['full_name_display']} → {r}")
    return n

def cmd_new_project(args):
    auth()
    if not args.desc: die("описание обязательно: Taiga отвечает 400 без него")
    if args.duplicate and args.sample: die("--duplicate и --sample вместе не имеют смысла")
    mods = [m.strip() for m in (args.modules or "epics,kanban").split(",") if m.strip()]
    ok(f"создать проект «{args.name}»")
    ok(f"  описание: {args.desc}")
    ok(f"  доступ:   {'приватный' if not args.public else 'публичный'}")
    ok(f"  включить: {', '.join(mods) or '—'}")
    if args.duplicate:
        ok(f"  способ:   ДУБЛИКАТ проекта «{args.duplicate}»")
        ok(f"            переносятся все четыре каталога статусов, роли, произвольные поля")
        ok(f"            НЕ переносятся: спринты, единицы работы, участники")
        ok(f"            состояние модулей берётся от образца — выключенные останутся выключенными")
    elif args.sample: ok(f"  колонки:  перенести из «{args.sample}» (только статусы историй)")
    if args.init:   ok(f"  подключить текущую папку: {pathlib.Path.cwd()}")
    if not confirm(args, ""): return

    if args.duplicate:
        c, sp = api("GET", f"/projects/by_slug?slug={args.duplicate}")
        if c != 200: die(f"образец «{args.duplicate}» не найден ({c})")
        c, p = api("POST", f"/projects/{sp['id']}/duplicate",
                   {"name": args.name, "description": args.desc,
                    "is_private": not args.public, "users": []})
    else:
        c, p = api("POST", "/projects", {"name": args.name, "description": args.desc,
                                         "is_private": not args.public})
    if c != 201: die(f"создание отклонено {c}: {p}")
    pid, slug = p["id"], p["slug"]
    ok(f"\nсоздан: «{p['name']}» id={pid} слаг={slug}")   # слаг из ответа, не угаданный

    if mods:
        body = {f"is_{m}_activated": True for m in mods}
        c, r = api("PATCH", f"/projects/{pid}", body)      # у проекта нет version
        if c != 200: ok(f"  ! включение модулей → {c} {r}")
        c, chk = api("GET", f"/projects/{pid}")
        for m in mods:
            key = f"is_{m}_activated"
            if key not in chk: ok(f"  ! модуля {m} не существует")
            elif not chk[key]: ok(f"  ! модуль {m} НЕ включился")
            else: ok(f"  модуль {m}: включён")

    if args.sample and not args.duplicate:
        made, names = copy_columns(pid, args.sample)
        ok(f"  колонки перенесены (создано {made}): {', '.join(names)}")

    if args.users:
        add_members(pid, [x.strip() for x in args.users.split(",") if x.strip()], args.role, args)

    if args.init:
        ns = argparse.Namespace(slug=slug, name=None, here=False, force=True,
                                project=None, yes=True, kind=None)
        cmd_init(ns)
    ok(f"\nготово. Дальше: taiga init {slug}  —  в папке проекта")


# ── синхронизация статусов история ← задачи ──────────────────────────────────
# Taiga этого не делает: у историй и задач РАЗНЫЕ каталоги статусов, и закрытие
# всех задач не двигает историю. Правило строится на признаке is_closed и порядке
# order, а не на названиях: на одном инстансе схемы каталогов могут различаться.
def _status_scale(statuses):
    """Упорядоченный список статусов и индекс по id — для сравнения «дальше/раньше»."""
    srt = sorted(statuses, key=lambda s: (s.get("order", 0), s["id"]))
    return srt, {s["id"]: i for i, s in enumerate(srt)}

def plan_sync(pid):
    """Для каждой истории с задачами — какой статус ей полагается по задачам."""
    c, us_st = api("GET", f"/userstory-statuses?project={pid}")
    c, tk_st = api("GET", f"/task-statuses?project={pid}")
    us_srt, us_idx = _status_scale(us_st or [])
    tk_closed = {s["id"] for s in (tk_st or []) if s.get("is_closed")}
    tk_first = _status_scale(tk_st or [])[0][0]["id"] if tk_st else None

    us_done = next((s for s in us_srt if s.get("is_closed")), None)
    # «в работе» ищем по имени (оно совпадает в обеих схемах), иначе — середина шкалы
    us_prog = next((s for s in us_srt if "progress" in s["name"].lower()), None) \
              or (us_srt[len(us_srt)//2] if us_srt else None)
    if not us_done or not us_prog: die("в проекте нет закрывающего или рабочего статуса историй")

    c, uss = api("GET", f"/userstories?project={pid}", nopage=True)
    c, tks = api("GET", f"/tasks?project={pid}", nopage=True)
    by = {}
    for t in (tks or []):
        if t.get("user_story"): by.setdefault(t["user_story"], []).append(t)

    rows = []
    for u in (uss or []):
        kids = by.get(u["id"])
        if not kids: continue                     # истории без задач не трогаем
        closed = [k for k in kids if k["status"] in tk_closed]
        started = [k for k in kids if k["status"] not in tk_closed and k["status"] != tk_first]
        if len(closed) == len(kids):   want = us_done
        elif closed or started:        want = us_prog
        else:                          continue   # все задачи в начальном — нечего менять
        cur_i = us_idx.get(u["status"], -1); want_i = us_idx.get(want["id"], -1)
        if cur_i >= want_i: continue              # только вперёд: назад не откатываем
        rows.append({"us": u, "want": want, "kids": len(kids), "closed": len(closed),
                     "from": (u.get("status_extra_info") or {}).get("name", "?")})
    return rows

def cmd_sync(args):
    p = project(args); rows = plan_sync(p["id"])
    if args.ref:
        r = int(re.sub(r"\D", "", str(args.ref)))
        rows = [x for x in rows if x["us"]["ref"] == r]
    ok(f"{p['name']}: историй к переводу — {len(rows)}")
    if not rows:
        ok("расхождений нет (истории без задач и откаты назад не учитываются)"); return
    for x in rows:
        ok(f"  #{x['us']['ref']:<5} {x['us']['subject'][:46]:<48} "
           f"{x['from']} → {x['want']['name']}   (задач {x['closed']}/{x['kids']} закрыто)")
    if args.dry: ok("\n(сухой прогон — ничего не записано)"); return
    if not confirm(args, f"\nперевести {len(rows)} историй"): return
    done = fail = 0
    for x in rows:
        uid = x["us"]["id"]
        for _ in range(3):
            c, cur = api("GET", f"/userstories/{uid}")
            if c != 200: fail += 1; break
            c, r = api("PATCH", f"/userstories/{uid}",
                       {"version": cur["version"], "status": x["want"]["id"]})
            if c == 200:
                done += 1
                ok(f"  #{r['ref']} → {r['status_extra_info']['name']} "
                   f"(закрыта: {r['status_extra_info'].get('is_closed')})")
                break
            if "doesn't match" in json.dumps(r, ensure_ascii=False): continue
            ok(f"  ! #{x['us']['ref']} → {c} {r}"); fail += 1; break
    ok(f"\nпереведено {done}, отказов {fail}")


# ── триаж: что из нового непригодно для работы ───────────────────────────────
# Признак «нет описания» сам по себе не годится: в части проектов заголовок
# самодостаточен, а у историй описание бывает в дочерних задачах. Поэтому
# флаги ставятся по совокупности, и молчание — поведение по умолчанию.
STUB_TITLES = {"другие задачи", "прочее", "разное", "задачи", "тест", "test",
               "экспорт", "импорт", "доработки", "правки", "баги", "fix", "todo"}

# ── стандарт оформления тикетов ────────────────────────────────────────────
# Проверки взяты из «Стандарта оформления тикетов в Taiga — EGSV MEGACAM»
# (Л. Самборский, QA, 08.10.2026). Сам стандарт живёт у тестировщиков:
# это процесс компании, а не поведение инструмента. Здесь — только то,
# что проверяется механически, без догадок.
TICKET_SECTIONS = ("ОКРУЖЕНИЕ", "РЕПРО", "ОЖИДАЛОСЬ", "ФАКТИЧЕСКИ")
SEVERITIES = ("blocker", "critical", "major", "minor", "trivial")
TEAMS = ("бэк", "фронт", "инфра", "sec", "мобилка", "qa")
# Пароль в описании — это утечка, а не огрех оформления. Ищем «ключ: значение»,
# иначе сработает на каждом «забыл пароль» в тексте бага.
SECRET_RE = re.compile(r"(?i)(пароль|password|passwd|token|токен|api[ _-]?key|secret|credential)"
                       r"\s*[:=]\s*\S{4,}")
STEP_RE = re.compile(r"^\s*1\s*[.)]\s*\S", re.M)

def triage_bug(subj, desc, full):
    """Замечания к баг-репорту по стандарту. Только для карточек в BUG.

    Вложений нет у 52 багов из 53 — проверено на живых данных. Такое
    замечание в каждой карточке не замечание, а шум, после которого
    перестают читать весь список. Поэтому оно идёт общей строкой
    в конце разбора, а не меткой на каждой."""
    flags = []
    low = desc.lower()
    if not re.match(r"^\s*\[[^\]]{2,40}\]\s*\S", subj):
        flags.append("заголовок без «[Раздел/Команда] суть»")
    miss = [x for x in TICKET_SECTIONS if x.lower() not in low]
    if len(miss) == len(TICKET_SECTIONS):
        flags.append("описание не по шаблону: нет ни одного раздела "
                     "(ОКРУЖЕНИЕ, РЕПРО, ОЖИДАЛОСЬ, ФАКТИЧЕСКИ)")
    elif miss:
        flags.append("нет разделов: " + ", ".join(miss))
    if "репро" in low and not STEP_RE.search(desc):
        flags.append("шаги воспроизведения не пронумерованы")
    tags = " ".join(str(t[0] if isinstance(t, (list, tuple)) else t)
                    for t in (full.get("tags") or [])).lower()
    if not (any(x in tags for x in SEVERITIES) or "severity" in low):
        flags.append("не указана severity — ни в тегах, ни в описании")
    if not (any(x in tags for x in TEAMS) or "команда" in low):
        flags.append("не указана команда — ни в тегах, ни в описании")
    if SECRET_RE.search(desc):
        flags.append("⚠ в описании похоже на пароль или токен — убрать немедленно")
    return flags

def triage_item(o, full, kids_desc, closed_ids):
    """Список замечаний к единице работы. Пусто — вопросов нет."""
    flags = []
    subj = (o.get("subject") or "").strip()
    desc = (full.get("description") or "").strip()
    has_text = len(desc) >= 80 or kids_desc
    if subj.lower() in STUB_TITLES:
        flags.append("заголовок-заглушка: по нему нельзя понять задачу")
    elif not has_text and len(subj) < 40:
        flags.append(f"нет описания, заголовок короткий ({len(subj)} симв.)")
    if not o.get("assigned_to") and o["status"] not in closed_ids:
        flags.append("не назначена ни на кого")
    st = (o.get("status_extra_info") or {}).get("name", "").lower()
    if "bug" in st:
        if has_text: flags += triage_bug(subj, desc, full)
        else: flags.append("баг без описания — по стандарту нужны шаги, окружение и роль")
    return flags

def cmd_triage(args):
    if args.all:
        c, ps = api("GET", "/projects")
        first = True
        for pr in sorted(ps or [], key=lambda x: x["name"].lower()):
            if not first: ok("")
            first = False
            ns = argparse.Namespace(**{**vars(args), "all": False, "project": pr["slug"]})
            try: _triage_one(ns)
            except SystemExit as e: ok(f"{pr['name']}: {e}")
        return
    _triage_one(args)

def _triage_one(args):
    from datetime import datetime, timezone, timedelta
    p = project(args); pid = p["id"]
    since = datetime.now(timezone.utc) - timedelta(days=int(args.days))
    def _dt(s): return datetime.fromisoformat(s.replace("Z", "+00:00")) if s else None

    c, tks = api("GET", f"/tasks?project={pid}", nopage=True)
    kids = {}
    for k in (tks or []):
        if k.get("user_story"): kids.setdefault(k["user_story"], []).append(k)

    total = 0; rows = []; bugs = 0; noatt = 0
    for kind, ep in (("us","userstory-statuses"),
                     ("task","task-statuses"),
                     ("issue","issue-statuses")):
        c, st = api("GET", f"/{ep}?project={pid}")
        closed_ids = {s["id"] for s in (st or []) if s.get("is_closed")}
        c, items = api("GET", f"/{KINDS[kind][0]}?project={pid}", nopage=True)
        for o in (items or []):
            if not (_dt(o.get("created_date")) and _dt(o["created_date"]) >= since): continue
            total += 1
            c, full = api("GET", f"/{KINDS[kind][0]}/{o['id']}")
            kd = False
            if kind == "us":
                for k in kids.get(o["id"], []):
                    c, kf = api("GET", f"/tasks/{k['id']}")
                    if len((kf.get("description") or "").strip()) >= 80: kd = True; break
            fl = triage_item(o, full, kd, closed_ids)
            st_name = (o.get("status_extra_info") or {}).get("name", "").lower()
            if "bug" in st_name:
                bugs += 1
                if not (full.get("attachments") or []): noatt += 1
            if fl: rows.append((kind, o, fl))

    ok(f"{p['name']}: новых за {args.days} дн — {total}, с замечаниями — {len(rows)}")
    if noatt:
        ok(f"  без вложений (скрины, видео, MD-разбор): {noatt} багов из {bugs}")
    if not rows:
        ok("всё оформлено достаточно для работы"); return
    for kind, o, fl in sorted(rows, key=lambda x: -x[1]["ref"]):
        ok(f"\n  #{o['ref']} · {KINDS[kind][3]} · {o['subject'][:56]}")
        for x in fl: ok(f"      — {x}")
    if not args.comment:
        ok(f"\n(отчёт; комментарии в трекер не ставились — для этого ключ --comment)")
        return
    ok("")
    if not confirm(args, f"оставить комментарий в {len(rows)} тикетах"): return
    n = 0
    for kind, o, fl in rows:
        text = ("Автопроверка оформления. Чтобы задачу можно было взять в работу, не хватает:\n"
                + "\n".join(f"- {x}" for x in fl))
        c, h = api("GET", f"/history/{KINDS[kind][1]}/{o['id']}")
        if any("Автопроверка оформления" in (e.get("comment") or "") for e in (h or [])):
            ok(f"  #{o['ref']} уже прокомментирован"); continue
        c, cur = api("GET", f"/{KINDS[kind][0]}/{o['id']}")
        c, r = api("PATCH", f"/{KINDS[kind][0]}/{o['id']}", {"version": cur["version"], "comment": text})
        if c == 200: n += 1; ok(f"  #{o['ref']} прокомментирован")
        else: ok(f"  ! #{o['ref']} → {c}")
    ok(f"\nпрокомментировано {n}")


# ── дозорный: опрос Тайги и заготовки триажа в папках проектов ──────────────
STATE = HOME / ".taiga-kit" / "watch-state.json"
WEB_PATH = {"us": "us", "task": "task", "issue": "issue", "epic": "epic"}

def state_load():
    if not STATE.is_file(): return {}
    try: return json.loads(STATE.read_text())
    except json.JSONDecodeError: return {}

def state_save(d):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    t = STATE.with_suffix(".tmp"); t.write_text(json.dumps(d, ensure_ascii=False, indent=2)); t.replace(STATE)

def _slugify(s, n=40):
    s = re.sub(r"[^\w\s-]", "", s, flags=re.U).strip().lower()
    return re.sub(r"[\s_]+", "-", s)[:n].strip("-") or "без-названия"

def notify(title, text):
    """Уведомление macOS. На других системах молча пропускаем."""
    if sys.platform != "darwin": return
    try:
        esc = lambda s: s.replace("\\", "\\\\").replace('"', '\\"')
        subprocess.run(["osascript", "-e",
                        f'display notification "{esc(text)}" with title "{esc(title)}"'],
                       capture_output=True, timeout=10)
    except Exception: pass

def stub_text(slug, pname, kind, o, full, flags, base_url):
    import datetime
    url = f"{base_url}/project/{slug}/{WEB_PATH[kind]}/{o['ref']}"
    who = (o.get("assigned_to_extra_info") or {}).get("full_name_display") or "не назначена"
    st = (o.get("status_extra_info") or {}).get("name", "?")
    desc = (full.get("description") or "").strip() or "_описания в тикете нет_"
    gaps = "\n".join(f"- {x}" for x in flags) if flags else "_замечаний нет_"
    return f"""---
тикет: {pname} #{o['ref']}
слаг: {slug}
род: {KINDS[kind][3]}
статус: ждёт разведки
создан: {datetime.date.today().isoformat()}
---

# {o['subject']}

{url}

статус в трекере: {st} · исполнитель: {who}

## Что в тикете

{desc}

## Чего не хватает в тикете

{gaps}

## Что нашлось в коде

_не заполнено. В сессии с этой папкой скажите: разбери {o['ref']}_

## Гипотеза

_не заполнено_

## Что предлагаю

_не заполнено_
"""


LAUNCH_LABEL = "kz.taiga-kit.watch"


# ── расписание через cron: всё, что не macOS и не Windows ───────────────────
# Метка в конце строки — для оболочки комментарий, для нас опознавательный
# знак. По ней и только по ней ищем свои строки при переустановке: чужой
# crontab трогать нельзя, его писал человек.
CRON_MARK = "# taiga-kit:"

def cron_read():
    r = subprocess.run(["crontab", "-l"], capture_output=True, text=True)
    return (r.stdout or "").splitlines() if r.returncode == 0 else []

def cron_write(lines):
    body = "\n".join(l for l in lines if l.strip()) + "\n"
    r = subprocess.run(["crontab", "-"], input=body, capture_output=True, text=True)
    if r.returncode: die(f"crontab: {(r.stderr or r.stdout).strip()}")

def cron_job(tag, jobs, uninstall=False):
    """jobs — список пар (расписание cron, аргументы программы)."""
    exe = str(pathlib.Path(sys.argv[0]).resolve())
    log = HOME / ".taiga-kit" / f"{tag}.log"
    line = lambda a: f"{sys.executable} {exe} {' '.join(a)} >> {log} 2>&1"
    if not shutil.which("crontab"):
        if uninstall: ok("crontab на этой системе нет — снимать нечего"); return
        ok("crontab не найден. Строки для вашего планировщика:")
        for spec, a in jobs: ok(f"  {spec}  {line(a)}")
        return
    keep = [l for l in cron_read() if not l.rstrip().endswith(CRON_MARK + tag)]
    if uninstall:
        cron_write(keep); ok(f"строки «{tag}» убраны из crontab"); return
    log.parent.mkdir(parents=True, exist_ok=True)
    for spec, a in jobs: keep.append(f"{spec} {line(a)} {CRON_MARK}{tag}")
    cron_write(keep)
    ok(f"расписание поставлено в crontab:")
    for spec, a in jobs: ok(f"  {spec}  taiga {' '.join(a)}")
    ok(f"журнал: {log}")
    ok(f"снять: taiga {tag} --uninstall")

def cron_days(all_days): return "*" if all_days else "1-5"

def watch_install(args):
    """Расписание дозорного. macOS — launchd; на другом — подсказка для cron."""
    exe = str((pathlib.Path(sys.argv[0]).resolve()))
    if sys.platform == "win32":
        # Планировщик заданий: еженедельно по будням, старт 9:05, повтор каждый час 10 часов.
        # На живой Windows не проверялось.
        name = "TaigaKitWatch"
        if args.uninstall:
            r = subprocess.run(["schtasks", "/Delete", "/TN", name, "/F"], capture_output=True, text=True)
            ok("расписание снято" if not r.returncode else f"schtasks: {r.stdout}{r.stderr}")
            return
        cmd = f'"{sys.executable}" "{exe}" watch'
        h_from, h_to, every = int(args.start), int(args.end), max(1, int(args.every))
        dw = "MON,TUE,WED,THU,FRI,SAT,SUN" if args.all_days else "MON,TUE,WED,THU,FRI"
        r = subprocess.run(["schtasks", "/Create", "/TN", name, "/TR", cmd,
                            "/SC", "WEEKLY", "/D", dw,
                            "/ST", f"{h_from:02d}:05", "/RI", str(every * 60),
                            "/DU", f"{max(1, h_to - h_from):04d}:00", "/F"],
                           capture_output=True, text=True)
        if r.returncode: die(f"schtasks: {r.stdout}{r.stderr}")
        ok(f"расписание поставлено: задание «{name}»")
        ok(f"{'каждый час' if every == 1 else f'каждые {every} ч'} с {h_from}:05 до {h_to}:05")
        ok("снять: taiga watch --uninstall")
        return
    if sys.platform != "darwin":
        h_from, h_to, every = int(args.start), int(args.end), max(1, int(args.every))
        return cron_job("watch", [(f"5 {h_from}-{h_to}/{every} * * {cron_days(args.all_days)}",
                                   ["watch"])], args.uninstall)
    plist = HOME / "Library" / "LaunchAgents" / f"{LAUNCH_LABEL}.plist"
    if args.uninstall:
        subprocess.run(["launchctl", "unload", str(plist)], capture_output=True)
        if plist.exists(): plist.unlink()
        ok(f"расписание снято: {plist}"); return
    h_from, h_to, every = int(args.start), int(args.end), max(1, int(args.every))
    if not (0 <= h_from <= 23 and 0 <= h_to <= 23 and h_from <= h_to):
        die("часы должны быть 0–23 и --start не позже --end")
    days = range(1, 6) if not args.all_days else range(0, 7)
    hour_list = list(range(h_from, h_to + 1, every))
    hours = "".join(
        f"    <dict><key>Weekday</key><integer>{d}</integer>"
        f"<key>Hour</key><integer>{h}</integer><key>Minute</key><integer>5</integer></dict>\n"
        for d in days for h in hour_list)
    log = HOME / ".taiga-kit"
    log.mkdir(parents=True, exist_ok=True)
    plist.parent.mkdir(parents=True, exist_ok=True)
    plist.write_text(f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>{LAUNCH_LABEL}</string>
  <key>ProgramArguments</key>
  <array><string>{sys.executable}</string><string>{exe}</string><string>watch</string></array>
  <key>StartCalendarInterval</key>
  <array>
{hours}  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>{os.path.expanduser("~/.local/bin")}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StandardOutPath</key><string>{log}/watch.log</string>
  <key>StandardErrorPath</key><string>{log}/watch.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
""")
    subprocess.run(["launchctl", "unload", str(plist)], capture_output=True)
    r = subprocess.run(["launchctl", "load", str(plist)], capture_output=True, text=True)
    if r.returncode: die(f"launchctl: {r.stderr.strip()}")
    ok(f"расписание поставлено: {plist}")
    sched = ("каждый час" if every == 1 else f"каждые {every} ч")
    ok(f"{sched} с {h_from}:05 до {h_to}:05, "
       f"{'все дни' if args.all_days else 'по будням'} ({len(hour_list) * len(list(days))} проверок в неделю)")
    ok(f"журнал: {log}/watch.log")
    ok("снять: taiga watch --uninstall")


# ── ежедневный отчёт по активности ──────────────────────────────────────────
CONFIG = HOME / ".taiga-kit" / "config.json"

def cfg_load():
    if not CONFIG.is_file(): return {}
    try: d = json.loads(CONFIG.read_text())
    except json.JSONDecodeError: return {}
    return d if isinstance(d, dict) else {}

def cfg_set(key, value):
    d = cfg_load(); d[key] = value
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    tmp = CONFIG.with_suffix(".tmp")
    tmp.write_text(json.dumps(d, ensure_ascii=False, indent=2) + "\n"); tmp.replace(CONFIG)

def reports_dir():
    """Куда складывать отчёты. Запомненный путь главнее умолчания."""
    v = cfg_load().get("reports_dir")
    return pathlib.Path(os.path.expanduser(v)) if v else HOME / ".taiga-kit" / "отчёты"
REPORT_LABEL = "kz.taiga-kit.report"

def report_window(now_local):
    """[предыдущий рабочий день 00:00, сегодня 00:00) местного времени.
    Во вторник–пятницу это вчера; в понедельник — пятница, суббота, воскресенье."""
    import datetime
    today = now_local.replace(hour=0, minute=0, second=0, microsecond=0)
    prev = today - datetime.timedelta(days=1)
    while prev.weekday() >= 5: prev -= datetime.timedelta(days=1)
    return prev, today

def report_install(args):
    exe = str(pathlib.Path(sys.argv[0]).resolve())
    if sys.platform == "win32":
        name = "TaigaKitReport"
        if args.uninstall:
            r = subprocess.run(["schtasks","/Delete","/TN",name,"/F"], capture_output=True, text=True)
            ok("расписание снято" if not r.returncode else f"schtasks: {r.stdout}{r.stderr}"); return
        hh, _, mm = args.at.partition(":")
        dw = "MON,TUE,WED,THU,FRI,SAT,SUN" if args.all_days else "MON,TUE,WED,THU,FRI"
        r = subprocess.run(["schtasks","/Create","/TN",name,"/TR",f'"{sys.executable}" "{exe}" report',
                            "/SC","WEEKLY","/D",dw,"/ST",f"{int(hh):02d}:{int(mm or 0):02d}","/F"],
                           capture_output=True, text=True)
        if r.returncode: die(f"schtasks: {r.stdout}{r.stderr}")
        ok(f"расписание поставлено: задание «{name}», {hh}:{int(mm or 0):02d}"); return
    if sys.platform != "darwin":
        hh, _, mm = args.at.partition(":")
        return cron_job("report", [(f"{int(mm or 0)} {int(hh)} * * {cron_days(args.all_days)}",
                                    ["report"])], args.uninstall)
    plist = HOME / "Library" / "LaunchAgents" / f"{REPORT_LABEL}.plist"
    if args.uninstall:
        subprocess.run(["launchctl","unload",str(plist)], capture_output=True)
        if plist.exists(): plist.unlink()
        ok(f"расписание снято: {plist}"); return
    log = HOME / ".taiga-kit"; log.mkdir(parents=True, exist_ok=True)
    plist.parent.mkdir(parents=True, exist_ok=True)
    hh, _, mm = args.at.partition(":")
    try: hh, mm = int(hh), int(mm or 0)
    except ValueError: die("время в виде ЧЧ:ММ, например 09:30")
    if not (0 <= hh <= 23 and 0 <= mm <= 59): die("часы 0–23, минуты 0–59")
    dd = range(0, 7) if args.all_days else range(1, 6)
    days = "".join(f"    <dict><key>Weekday</key><integer>{d}</integer>"
                   f"<key>Hour</key><integer>{hh}</integer><key>Minute</key><integer>{mm}</integer></dict>\n"
                   for d in dd)
    plist.write_text(f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>{REPORT_LABEL}</string>
  <key>ProgramArguments</key>
  <array><string>{sys.executable}</string><string>{exe}</string><string>report</string></array>
  <key>StartCalendarInterval</key>
  <array>
{days}  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>{os.path.expanduser("~/.local/bin")}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StandardOutPath</key><string>{log}/report.log</string>
  <key>StandardErrorPath</key><string>{log}/report.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
""")
    subprocess.run(["launchctl","unload",str(plist)], capture_output=True)
    r = subprocess.run(["launchctl","load",str(plist)], capture_output=True, text=True)
    if r.returncode: die(f"launchctl: {r.stderr.strip()}")
    ok(f"расписание поставлено: {plist}")
    ok(f"{'каждый день' if args.all_days else 'будни'} в {hh:02d}:{mm:02d} · "
       f"отчёт за предыдущий рабочий день")
    ok(f"папка: {reports_dir()}")
    ok("снять: taiga report --uninstall")

def scan_day(start, end, projects=None, users=None):
    """Переходы статусов и созданное за окно [start, end) по всем проектам.

    Закрытость берётся из КАТАЛОГА статусов проекта, а не из поля is_closed
    объекта: поле устаревает после переименования статуса (проверено —
    расходится примерно на 5% объектов). Общая для отчёта и вечерней сводки,
    чтобы цифры в них не разъезжались."""
    import datetime
    _d = lambda s: datetime.datetime.fromisoformat(s.replace("Z","+00:00")) if s else None
    if users is None:
        c, users_raw = api("GET", "/users")
        users = {u["id"]: (u.get("full_name_display") or u.get("username")) for u in (users_raw or [])}
    if projects is None:
        c, projects = api("GET", "/projects")
        if projects == []: die("список проектов пуст при подтверждённой личности — подозрительно")
    scan = start - datetime.timedelta(days=2)
    events, created = [], []
    for p in (projects or []):
        pid, pname = p["id"], p["name"]
        cat = {}
        for kind, ep, api_name in (("us","userstory-statuses","userstory"),
                                   ("task","task-statuses","task"),
                                   ("issue","issue-statuses","issue")):
            c, objs = api("GET", f"/{KINDS[kind][0]}?project={pid}", nopage=True)
            touched = [o for o in (objs or []) if _d(o.get("modified_date")) and _d(o["modified_date"]) >= scan]
            if touched and kind not in cat:
                c, st = api("GET", f"/{ep}?project={pid}")
                for s in (st or []): cat[(kind, s["name"])] = s.get("is_closed", False)
            for o in touched:
                cd = _d(o.get("created_date"))
                if cd and start <= cd < end:
                    created.append({"project": pname, "slug": p.get("slug"), "kind": kind,
                                    "ref": o["ref"], "subject": o["subject"], "at": o["created_date"],
                                    "who": users.get(o["owner"], f"id {o['owner']}")})
                c, h = api("GET", f"/history/{api_name}/{o['id']}")
                for e in (h or []):
                    vd = e.get("values_diff") or {}
                    if "status" not in vd: continue
                    tm = _d(e["created_at"])
                    if not (start <= tm < end): continue
                    events.append({"project": pname, "slug": p.get("slug"), "kind": kind,
                                   "ref": o["ref"], "subject": o["subject"], "at": e["created_at"],
                                   "who": (e.get("user") or {}).get("name") or "?",
                                   "from": vd["status"][0], "to": vd["status"][1],
                                   "to_closed": cat.get((kind, vd["status"][1]), False),
                                   "from_closed": cat.get((kind, vd["status"][0]), False)})
    return events, created, users, projects


# ── вечерняя сводка «план против факта» ─────────────────────────────────────
# План берётся из карточек «Чек-статус» проекта руководителей, факт — из
# журнала переходов. Разбор описания намеренно снисходительный: регламент
# есть, но карточки заполняют люди, и падать из-за лишней звёздочки сводка
# не должна. Чего разобрать не удалось — перечисляется прямым текстом,
# а не замалчивается: пустая сводка и сводка по неразобранной карточке
# выглядят одинаково, и это опасно.
STANDUP_PROJECT = "projectmanager"
CHECK_RE = re.compile(r"^Чек-статус\s+(?:пн|вт|ср|чт|пт|сб|вс)\s+(\d{2})\.(\d{2})\.(\d{4})\s*[—–-]\s*(.+?)\s*$")
LINK_RE  = re.compile(r"https?://[^\s)\]]+/project/([a-zA-Z0-9][\w.-]*)/(us|task|issue|epic)/(\d+)")
BARE_RE  = re.compile(r"(?<![\w/#])#(\d{1,6})\b")
_MARK    = lambda n: re.compile(r"^\s*[*_]{0,2}\s*" + str(n) + r"\s*\\?[.)]")
M_DONE, M_PLAN, M_Q = _MARK(1), _MARK(2), _MARK(3)
_JUNK = ("итоги", "решения", "блокеры", "цели недели", "риски", "результат",
         "задачи —", "пункт «план»", "ежедневный", "каждый участник", "запишите")

def _su_name(line, nxt=""):
    """Строка — заголовок участника? Возвращает имя или None."""
    s = line.strip()
    m = re.match(r"^#{1,6}\s*(.+?)\s*$", s)
    if m: s = m.group(1).strip()
    mu = re.match(r"^[*_]{0,2}\s*Участник:?\s*(.+?)\s*[*_]{0,2}$", s)
    if mu:
        s = mu.group(1)                        # «**Участник: Артур Виденмаер**»
    elif re.match(r"^[*_]{0,2}[A-Za-zА-ЯЁа-яё][^:|]{1,40}:[*_]{0,2}\s*$", s):
        pass                                   # «Леонид:» — стиль одного из PM
    elif (len(s) <= 40 and s and not s[0].isdigit() and ":" not in s
          and not LINK_RE.search(s) and (M_DONE.match(nxt) or _MARK(1).match(nxt))):
        pass                                   # имя строкой, следом «1. …»
    else:
        return None
    s = re.sub(r"^\**\s*Участник:?\s*", "", s).strip(" *_:")
    if not s or set(s) <= set("_ -—.") or len(s) > 48: return None
    if any(s.lower().startswith(j) for j in _JUNK): return None
    if s.lower().startswith(("что сделано", "что планируется", "какие есть")): return None
    return s

def r_body(r):
    """Короткая врезка прозаического плана: видно, что человек написал,
    и видно, почему это не сверить с трекером."""
    t = " ".join((r.get("body") or "").split())
    return (t[:110] + "…") if len(t) > 110 else (t or "—")

def standup_parse(desc):
    """Описание чек-статуса → список участников с планом."""
    lines = (desc or "").splitlines()
    blocks, cur = [], None
    for i, ln in enumerate(lines):
        nxt = next((x for x in lines[i+1:i+3] if x.strip()), "")
        nm = _su_name(ln, nxt)
        if nm is not None:
            cur = {"name": nm, "done": [], "plan": [], "q": [], "_sec": None}
            blocks.append(cur); continue
        if cur is None: continue
        low = ln.strip().lower()
        if M_DONE.match(ln) or low.startswith(("сделано", "**сделано")): cur["_sec"] = "done"
        elif M_PLAN.match(ln) or low.startswith(("план", "**план")):     cur["_sec"] = "plan"
        elif M_Q.match(ln) or low.startswith(("вопрос", "**вопрос")):    cur["_sec"] = "q"
        if cur["_sec"]: cur[cur["_sec"]].append(ln)
    out = []
    for b in blocks:
        txt = "\n".join(b["plan"])
        links = [(s.lower(), k, int(r)) for s, k, r in LINK_RE.findall(txt)]
        seen, uniq = set(), []
        for x in links:
            if x not in seen: seen.add(x); uniq.append(x)
        bare = sorted({int(r) for r in BARE_RE.findall(txt)})
        body = re.sub(r"^\s*[*_]{0,2}\s*2\s*\\?[.)]\s*", "", txt.strip())
        body = re.sub(r"^[*_]*\s*(Что планируется делать|Планируется|План)\s*[:?]?",
                      "", body, flags=re.I)
        body = body.strip(" *_:—-.\n")        # остался шаблон без ответа — считаем пустым
        out.append({"name": b["name"], "links": uniq, "bare": bare, "body": body,
                    "plan_text": txt.strip(), "done_text": "\n".join(b["done"]).strip()})
    return out

def standup_people(users_raw):
    return [{"id": u["id"], "display": u.get("full_name_display") or u.get("username") or "",
             "username": (u.get("username") or "")} for u in (users_raw or [])]

def standup_match(name, people):
    """Имя из карточки → человек в Taiga. Неуверенно — лучше никак."""
    n = name.strip().lower()
    if not n: return None
    for p in people:
        if p["display"].lower() == n or p["username"].lower() == n: return p
    words = [w for w in re.split(r"\s+", n) if w]
    hit = [p for p in people
           if n in p["display"].lower() or n in p["username"].lower()
           or (words and all(any(w == d for d in p["display"].lower().split()) for w in words))]
    return hit[0] if len(hit) == 1 else None

def standup_lookup(slug, kind, ref, cache):
    """Текущее состояние карточки по слагу/роду/номеру. Закрытость — из каталога."""
    key = (slug, kind)
    if slug not in cache["pid"]:
        c, p = api("GET", f"/projects/by_slug?slug={slug}")
        cache["pid"][slug] = (p or {}).get("id") if c == 200 else None
        cache["pname"][slug] = (p or {}).get("name") or slug
    pid = cache["pid"][slug]
    if not pid: return None
    if key not in cache["cat"]:
        c, st = api("GET", f"/{KINDS[kind][2]}?project={pid}")
        cache["cat"][key] = {s["id"]: (s["name"], s.get("is_closed", False)) for s in (st or [])}
    c, o = api("GET", f"/{KINDS[kind][0]}/by_ref?ref={ref}&project={pid}")
    if c != 200 or not o: return None
    nm, closed = cache["cat"][key].get(o["status"], ("?", False))
    return {"project": cache["pname"][slug], "slug": slug, "kind": kind, "ref": ref,
            "subject": o.get("subject") or "", "status": nm, "closed": closed}

TEST_COL = "ready for test"

def test_queue(projects):
    """Сколько карточек сейчас стоит в очереди на проверку, по проектам.
    Отдельный проход: журнал показывает движение, а не остаток."""
    out = {}
    for p in (projects or []):
        pid, n = p["id"], 0
        for kind, ep in (("us","userstory-statuses"),("task","task-statuses"),("issue","issue-statuses")):
            c, st = api("GET", f"/{ep}?project={pid}")
            ids = {x["id"] for x in (st or []) if x["name"].strip().lower() == TEST_COL}
            if not ids: continue
            c, objs = api("GET", f"/{KINDS[kind][0]}?project={pid}", nopage=True)
            n += sum(1 for o in (objs or []) if o["status"] in ids)
        if n: out[p["name"]] = n
    return out

def test_flow(events):
    """Движение через колонку проверки за день."""
    into = [x for x in events if x["to"].lower() == TEST_COL and x["from"].lower() != TEST_COL]
    out  = [x for x in events if x["from"].lower() == TEST_COL and x["to"].lower() != TEST_COL]
    passed = [x for x in out if x["to_closed"]]
    back   = [x for x in out if not x["to_closed"] and "bug" in x["to"].lower()]
    other  = [x for x in out if x not in passed and x not in back]
    return into, passed, back, other

def test_block(events, queue):
    """Раздел для файла сводки. Только арифметика по журналу."""
    into, passed, back, other = test_flow(events)
    tot = sum(queue.values())
    L = ["## Тестирование за день", "",
         "| | |", "|---|---:|",
         f"| Ушло на проверку | {len(into)} |",
         f"| Проверено и закрыто | {len(passed)} |",
         f"| Вернули в баги | {len(back)} |"]
    if other: L.append(f"| Ушло из проверки иначе | {len(other)} |")
    L.append(f"| **Стоит в очереди сейчас** | **{tot}** |")
    L.append("")
    delta = len(into) - len(passed) - len(back) - len(other)
    if delta > 0: L.append(f"Очередь выросла на {delta}: пришло {len(into)}, "
                           f"разобрано {len(into)-delta}.")
    elif delta < 0: L.append(f"Очередь сократилась на {-delta}.")
    else: L.append("Очередь не изменилась.")
    if queue:
        L.append("")
        L.append("В очереди по проектам: " +
                 ", ".join(f"{k} {v}" for k, v in sorted(queue.items(), key=lambda kv: -kv[1])))
    for name, rows in (("Ушло на проверку", into), ("Проверено и закрыто", passed),
                       ("Вернули в баги", back), ("Ушло из проверки иначе", other)):
        if not rows: continue
        L += ["", f"### {name} — {len(rows)}", "",
              "| Время | Проект | # | Название | Кто |", "|---|---|---:|---|---|"]
        for x in sorted(rows, key=lambda z: z["at"]):
            L.append(f"| {x['at'][11:16]} | {x['project']} | {x['ref']} "
                     f"| {cut(x['subject'], 46)} | {x['who']} |")
    return L

def test_tg(events, queue, only=None):
    """Та же сводка в двух словах, для сообщения руководителю.
    `only` — названия проектов, которые человек отметил себе в боте."""
    if only:
        events = [x for x in events if x["project"] in only]
        queue = {k: v for k, v in queue.items() if k in only}
    into, passed, back, other = test_flow(events)
    tot = sum(queue.values())
    L = ["", f"\U0001F9EA Тестирование: ушло {len(into)}, проверено {len(passed)}, "
             f"вернули {len(back)}", f"в очереди сейчас: {tot}"]
    if into:
        top = {}
        for x in into: top[x["project"]] = top.get(x["project"], 0) + 1
        L.append("ушло: " + ", ".join(f"{k} {v}" for k, v in sorted(top.items(), key=lambda kv: -kv[1])[:4]))
    if back:
        L.append("вернули: " + ", ".join(f"{x['project']} #{x['ref']}" for x in back[:5]))
    return L

def cmd_standup(args):
    import datetime
    if args.install or args.uninstall: return standup_install(args)
    auth()
    TZ = datetime.datetime.now().astimezone().tzinfo
    day = datetime.date.fromisoformat(args.day) if args.day else datetime.datetime.now(TZ).date()
    start_l = datetime.datetime(day.year, day.month, day.day, tzinfo=TZ)
    end_l = start_l + datetime.timedelta(days=1)
    start, end = start_l.astimezone(datetime.timezone.utc), end_l.astimezone(datetime.timezone.utc)
    slug = args.pm_project or cfg_load().get("standup_project", STANDUP_PROJECT)

    c, pr = api("GET", f"/projects/by_slug?slug={slug}")
    if c != 200 or not pr: die(f"проект руководителей «{slug}» не найден (сменить: --pm-project)")
    pid = pr["id"]
    c, st = api("GET", f"/userstory-statuses?project={pid}")
    scat = {s["id"]: (s["name"], s.get("is_closed", False)) for s in (st or [])}
    c, cards = api("GET", f"/userstories?project={pid}", nopage=True)
    if cards == []: die("в проекте руководителей пусто при подтверждённой личности — подозрительно")

    want = f"{day:%d}.{day:%m}.{day:%Y}"
    todays = []
    for o in (cards or []):
        m = CHECK_RE.match((o.get("subject") or "").strip())
        if not m: continue
        if f"{m.group(1)}.{m.group(2)}.{m.group(3)}" != want: continue
        c2, full = api("GET", f"/userstories/{o['id']}")
        todays.append({"ref": o["ref"], "pm": m.group(4).strip(),
                       "status": scat.get(o["status"], ("?", False))[0],
                       "done": scat.get(o["status"], ("?", False))[1],
                       "desc": (full or {}).get("description") or ""})
    todays.sort(key=lambda x: x["pm"])
    if args.only:
        todays = [t for t in todays if args.only.lower() in t["pm"].lower()]

    c, users_raw = api("GET", "/users")
    people = standup_people(users_raw)
    events, created, users, projects = scan_day(start, end)
    cache = {"pid": {}, "pname": {}, "cat": {}}
    moved = {}                               # (slug, kind, ref) → переходы за день
    for e in events:
        moved.setdefault((str(e["slug"]).lower(), e["kind"], e["ref"]), []).append(e)
    closed_by = {}                           # кто что закрыл за день
    for e in events:
        if e["to_closed"] and not e["from_closed"]:
            closed_by.setdefault(e["who"], []).append(e)

    blocks = []
    for t in todays:
        parts, probs = standup_parse(t["desc"]), []
        if not t["done"]: probs.append(f"карточка не в Done (сейчас {t['status']}) — план не зафиксирован")
        if not parts: probs.append("блоки по участникам не выделены — разобрать нечего")
        rows = []
        for p in parts:
            who = standup_match(p["name"], people)
            items, inplan = [], set()
            for s, k, r in p["links"]:
                it = standup_lookup(s, k, r, cache)
                if not it:
                    items.append({"bad": f"{s}/{k}/{r} — такой карточки нет"}); continue
                inplan.add((s, k, r))
                ev = moved.get((s, k, r), [])
                it["moved"] = ev
                it["done"] = any(x["to_closed"] and not x["from_closed"] for x in ev) or it["closed"]
                items.append(it)
            extra = []
            if who:
                for e in closed_by.get(who["display"], []):
                    if (str(e["slug"]).lower(), e["kind"], e["ref"]) not in inplan: extra.append(e)
            rows.append({"name": p["name"], "who": who, "items": items, "extra": extra,
                         "bare": p["bare"],
                         "body": p["body"],
                         "empty": not p["links"] and not p["bare"] and not p["body"],
                         "prose": not p["links"] and not p["bare"] and bool(p["body"])})
        blocks.append({"pm": t["pm"], "ref": t["ref"], "status": t["status"],
                       "rows": rows, "probs": probs})

    L = [f"# План против факта · {day:%d.%m.%Y}", "",
         f"Сформировано {datetime.datetime.now(TZ):%H:%M} · план — из карточек «Чек-статус» "
         f"проекта {pr.get('name') or slug}, факт — из журнала переходов.", ""]
    if not todays:
        L += [f"**Карточек «Чек-статус» на {day:%d.%m.%Y} не нашлось.**", "",
              "Либо дейлики не заводились, либо названия отличаются от "
              "`Чек-статус <дн> ДД.ММ.ГГГГ — <ПМ>`."]
    for b in blocks:
        L += [f"## {b['pm']} · #{b['ref']} · {b['status']}", ""]
        for pb in b["probs"]: L.append(f"> {pb}")
        if b["probs"]: L.append("")
        if not b["rows"]: continue
        L += ["| Участник | В плане | Закрыто | Сдвинулось | Не тронуто | Сверх плана |",
              "|---|---:|---:|---:|---:|---:|"]
        for r in b["rows"]:
            good = [i for i in r["items"] if not i.get("bad")]
            dn = len([i for i in good if i["done"]])
            mv = len([i for i in good if i["moved"] and not i["done"]])
            note = " _прозой_" if r["prose"] else (" _пусто_" if r["empty"] else "")
            L.append(f"| {r['name']}{note} | {len(good)} | {dn} | {mv} | "
                     f"{len(good)-dn-mv} | {len(r['extra'])} |")
        L.append("")
        for r in b["rows"]:
            L.append(f"**{r['name']}**" + ("" if r["who"] else "  ← в Taiga такого человека не нашёл"))
            if r["empty"]: L.append("- план не заполнен")
            elif r["prose"]: L.append(f"- план прозой, без ссылок — сверить не с чем: {r_body(r)}")
            for i in r["items"]:
                if i.get("bad"): L.append(f"- ❓ {i['bad']}"); continue
                mark = "✅" if i["done"] else ("▶" if i["moved"] else "⏸")
                tail = (" · ".join(f"{x['from']} → {x['to']}" for x in i["moved"][-2:])
                        if i["moved"] else i["status"])
                L.append(f"- {mark} {i['project']} #{i['ref']} · {i['subject'][:48]} · {tail}")
            if r["bare"]:
                L.append(f"- ❓ номера без ссылок, проект не определить: "
                         + ", ".join(f"#{x}" for x in r["bare"][:8]))
            for e in r["extra"]:
                L.append(f"- ➕ сверх плана: {e['project']} #{e['ref']} · {e['subject'][:48]} → {e['to']}")
            L.append("")
    tqueue = test_queue(projects)          # обход дорогой, делаем один раз
    L += [""] + test_block(events, tqueue)
    rd = reports_dir(); rd.mkdir(parents=True, exist_ok=True)
    out = rd / f"План-факт_{day:%Y-%m-%d}.md"
    out.write_text("\n".join(L) + "\n")
    ok(str(out))
    for b in blocks:
        tot = sum(len([i for i in r["items"] if not i.get("bad")]) for r in b["rows"])
        dn  = sum(len([i for i in r["items"] if not i.get("bad") and i["done"]]) for r in b["rows"])
        ex  = sum(len(r["extra"]) for r in b["rows"])
        ok(f"  {b['pm']:<22} в плане {tot:>3}, закрыто {dn:>3}, сверх плана {ex:>3}"
           + ("  ⚠ " + "; ".join(b["probs"]) if b["probs"] else ""))
    if not blocks: ok("  карточек на этот день нет")
    if args.send:
        q = tqueue
        slug2name = {p["slug"]: p["name"] for p in (projects or [])}
        subs = subs_load()
        rec = cfg_load().get("telegram_recipients", {})
        for b in blocks:
            tgt = next((v for v in rec.values() if b["pm"].lower() in (v.get("name") or "").lower()
                        or (v.get("name") or "").lower() in b["pm"].lower()), None)
            if not tgt: ok(f"  {b['pm']}: нет связанного чата — не отправлено"); continue
            # Человек мог отметить себе проекты в боте — тогда тестирование
            # показываем только по ним. Не отмечал — показываем всё.
            # Нет записи в боте — человек ничего не настраивал, шлём всё.
            # Есть запись, но проектов нет — он сам снял все галочки, и бот
            # ему об этом написал; показывать вопреки этому нельзя.
            sb = subs.get(str(tgt["chat_id"]))
            only = None
            if sb is not None and sb.get("evening"):
                only = {slug2name.get(x, x) for x in (sb.get("projects") or [])}
            r = tg_call("sendMessage", {"chat_id": tgt["chat_id"],
                                        "text": standup_tg(b, day) + "\n"
                                                + "\n".join(test_tg(events, q, only)),
                                        "disable_web_page_preview": True})
            ok(f"  {b['pm']}: {'отправлено' if r.get('ok') else 'ОШИБКА ' + str(r.get('description'))}")
    return out

def standup_tg(b, day):
    L = [f"План против факта · {day:%d.%m}", ""]
    for pb in b["probs"]: L.append(f"⚠ {pb}")
    if b["probs"]: L.append("")
    for r in b["rows"]:
        good = [i for i in r["items"] if not i.get("bad")]
        dn = len([i for i in good if i["done"]])
        tag = " · план пуст" if r["empty"] else (" · план прозой, без ссылок" if r["prose"] else "")
        L.append(f"{r['name']}: {dn} из {len(good)}{tag}")
        for i in good:
            if i["done"]: continue
            mark = "▶" if i["moved"] else "⏸"
            L.append(f"  {mark} {i['project']} #{i['ref']} · {i['subject'][:40]} · {i['status']}")
        for e in r["extra"][:4]:
            L.append(f"  ➕ {e['project']} #{e['ref']} · {e['subject'][:40]}")
        if r["bare"]: L.append(f"  ❓ без ссылок: " + ", ".join(f"#{x}" for x in r["bare"][:6]))
    if not b["rows"]: L.append("Карточка не разобрана: блоки по участникам не выделены.")
    return "\n".join(L)

STANDUP_LABEL = "kz.taiga-kit.standup"

def standup_install(args):
    exe = str(pathlib.Path(sys.argv[0]).resolve())
    if sys.platform == "win32":
        name = "TaigaKitStandup"
        if args.uninstall:
            r = subprocess.run(["schtasks","/Delete","/TN",name,"/F"], capture_output=True, text=True)
            ok("расписание снято" if not r.returncode else f"schtasks: {r.stdout}{r.stderr}"); return
        hh, _, mm = args.at.partition(":")
        r = subprocess.run(["schtasks","/Create","/TN",name,
                            "/TR",f'"{sys.executable}" "{exe}" standup --send',
                            "/SC","WEEKLY","/D","MON,TUE,WED,THU,FRI",
                            "/ST",f"{int(hh):02d}:{int(mm or 0):02d}","/F"], capture_output=True, text=True)
        if r.returncode: die(f"schtasks: {r.stdout}{r.stderr}")
        ok(f"расписание поставлено: «{name}», {hh}:{int(mm or 0):02d}"); return
    if sys.platform != "darwin":
        hh, _, mm = args.at.partition(":")
        return cron_job("standup", [(f"{int(mm or 0)} {int(hh)} * * 1-5",
                                     ["standup", "--send"])], args.uninstall)
    plist = HOME / "Library" / "LaunchAgents" / f"{STANDUP_LABEL}.plist"
    if args.uninstall:
        subprocess.run(["launchctl","unload",str(plist)], capture_output=True)
        if plist.exists(): plist.unlink()
        ok(f"расписание снято: {plist}"); return
    log = HOME / ".taiga-kit"; log.mkdir(parents=True, exist_ok=True)
    plist.parent.mkdir(parents=True, exist_ok=True)
    hh, _, mm = args.at.partition(":")
    try: hh, mm = int(hh), int(mm or 0)
    except ValueError: die("время в виде ЧЧ:ММ, например 19:00")
    if not (0 <= hh <= 23 and 0 <= mm <= 59): die("часы 0–23, минуты 0–59")
    days = "".join(f"    <dict><key>Weekday</key><integer>{d}</integer>"
                   f"<key>Hour</key><integer>{hh}</integer><key>Minute</key><integer>{mm}</integer></dict>\n"
                   for d in range(1, 6))
    plist.write_text(f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>{STANDUP_LABEL}</string>
  <key>ProgramArguments</key>
  <array><string>{sys.executable}</string><string>{exe}</string><string>standup</string><string>--send</string></array>
  <key>StartCalendarInterval</key>
  <array>
{days}  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>{os.path.expanduser("~/.local/bin")}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StandardOutPath</key><string>{log}/standup.log</string>
  <key>StandardErrorPath</key><string>{log}/standup.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
""")
    subprocess.run(["launchctl","unload",str(plist)], capture_output=True)
    r = subprocess.run(["launchctl","load",str(plist)], capture_output=True, text=True)
    if r.returncode: die(f"launchctl: {r.stderr.strip()}")
    ok(f"расписание поставлено: {plist}")
    ok(f"будни в {hh:02d}:{mm:02d} · сводка за текущий день, рассылка руководителям")
    ok(f"папка: {reports_dir()}")
    ok("снять: taiga standup --uninstall")


def cmd_report(args):
    import datetime
    if args.set_dir:
        p = pathlib.Path(os.path.expanduser(args.set_dir))
        p.mkdir(parents=True, exist_ok=True)
        old = reports_dir()
        moved = 0
        if old.is_dir() and old.resolve() != p.resolve():
            for src in sorted(old.glob("Отчёт_Taiga_*.md")):
                dst = p / src.name
                if dst.exists(): ok(f"  уже есть: {src.name}"); continue
                src.replace(dst); moved += 1
        cfg_set("reports_dir", str(p))
        ok(f"отчёты теперь в: {p}")
        if moved: ok(f"перенесено файлов: {moved} (из {old})")
        ok(f"путь запомнен в {CONFIG}")
        return
    if args.install or args.uninstall: return report_install(args)
    auth()
    TZ = datetime.datetime.now().astimezone().tzinfo       # часовой пояс машины, не прибитый
    start_l, end_l = report_window(datetime.datetime.now(TZ))
    if args.day:
        d = datetime.date.fromisoformat(args.day)
        start_l = datetime.datetime(d.year, d.month, d.day, tzinfo=TZ)
        end_l = start_l + datetime.timedelta(days=1)
    start, end = start_l.astimezone(datetime.timezone.utc), end_l.astimezone(datetime.timezone.utc)
    _d = lambda s: datetime.datetime.fromisoformat(s.replace("Z","+00:00")) if s else None
    loc = lambda s: _d(s).astimezone(TZ)

    events, created, users, projects = scan_day(start, end)
    keys = sorted({(e["who"], e["project"]) for e in events} | {(x["who"], x["project"]) for x in created})
    title = (f"{start_l:%d.%m.%Y}" if (end_l - start_l).days == 1
             else f"{start_l:%d.%m} – {end_l - datetime.timedelta(days=1):%d.%m.%Y}")
    L = [f"# Отчёт по Taiga за {title}", "",
         f"Сформировано {datetime.datetime.now(TZ):%Y-%m-%d %H:%M} · местное время · "
         f"окно {start_l:%d.%m} 00:00 – {end_l:%d.%m} 00:00", "",
         "«Взял» и «закрыл» — кто именно переставил карточку (журнал переходов). "
         "«Создал» — автор объекта.", "", "## Общая таблица", "",
         "| Человек | Проект | Создал | Взял в работу | Закрыл | Переходов |",
         "|---|---|---:|---:|---:|---:|"]
    tot = [0,0,0,0]; rows = []
    for who, prj in keys:
        ev = [x for x in events if x["who"] == who and x["project"] == prj]
        cr = len([x for x in created if x["who"] == who and x["project"] == prj])
        tk = len([x for x in ev if "progress" in x["to"].lower() and "progress" not in x["from"].lower()])
        cl = len([x for x in ev if x["to_closed"] and not x["from_closed"]])
        rows.append((who, prj, cr, tk, cl, len(ev)))
        for i, v in enumerate((cr, tk, cl, len(ev))): tot[i] += v
    for r in sorted(rows, key=lambda r: (-r[4], -r[3], -r[2], r[0])):
        L.append(f"| {r[0]} | {r[1]} | {r[2]} | {r[3]} | {r[4]} | {r[5]} |")
    if rows:
        L.append(f"| **Итого** | **{len({r[1] for r in rows})} проектов** | "
                 f"**{tot[0]}** | **{tot[1]}** | **{tot[2]}** | **{tot[3]}** |")
    else:
        L.append("| _активности не было_ | | | | | |")
    # ── что бросается в глаза: только арифметика, без оценок людей ──────────
    reopened = [x for x in events if x["from_closed"] and not x["to_closed"]]
    took = [x for x in events if "progress" in x["to"].lower() and "progress" not in x["from"].lower()]
    closed_ev = [x for x in events if x["to_closed"] and not x["from_closed"]]
    closed_refs = {(x["project"], x["ref"]) for x in closed_ev}
    took_open = [x for x in took if (x["project"], x["ref"]) not in closed_refs]
    by_closer = {}
    for x in closed_ev: by_closer[x["who"]] = by_closer.get(x["who"], 0) + 1
    silent = sorted({p["name"] for p in (projects or [])} -
                    {x["project"] for x in events} - {x["project"] for x in created})

    obs = []
    delta = tot[0] - tot[2]
    if delta > 0:
        obs.append(f"**Бэклог вырос на {delta}**: создано {tot[0]}, закрыто {tot[2]}.")
    elif delta < 0:
        obs.append(f"**Бэклог сократился на {-delta}**: закрыто {tot[2]}, создано {tot[0]}.")
    else:
        obs.append(f"Создано и закрыто поровну — по {tot[0]}.")
    if by_closer:
        top = sorted(by_closer.items(), key=lambda kv: -kv[1])
        who, n = top[0]
        if len(by_closer) == 1:
            obs.append(f"Все {n} закрытий — {who}.")
        elif n >= sum(by_closer.values()) * 0.5:
            obs.append(f"Больше половины закрытий ({n} из {sum(by_closer.values())}) — {who}.")
    if took_open:
        obs.append(f"**Взято в работу и не закрыто: {len(took_open)}** — "
                   + ", ".join(f"{x['project']} #{x['ref']}" for x in took_open[:6])
                   + (" и другие" if len(took_open) > 6 else "") + ".")
    if reopened:
        obs.append(f"**Переоткрыто: {len(reopened)}** — "
                   + ", ".join(f"{x['project']} #{x['ref']} ({x['from']} → {x['to']})"
                               for x in reopened[:4])
                   + (" и другие" if len(reopened) > 4 else "")
                   + ". Карточка вернулась из закрывающего статуса в рабочий.")
    if silent:
        obs.append(f"Без движения: {', '.join(silent)}.")
    if not events and not created:
        obs = ["За эти сутки в трекере не происходило ничего."]

    L += ["", "## Что бросается в глаза", ""]
    L += [f"- {x}" for x in obs]
    L += ["", "_Только арифметика по журналу переходов. Перемещение карточки измеряет и работу, "
          "и дисциплину ведения доски; карточки не нормированы по объёму. Выводы о людях "
          "по этим числам делать нельзя._"]

    L += ["", "## События статуса", "",
          "| Время | Человек | Проект | Род | # | Название | Из | В |", "|---|---|---|---|---:|---|---|---|"]
    for x in sorted(events, key=lambda z: z["at"]):
        L.append(f"| {loc(x['at']):%d.%m %H:%M} | {x['who']} | {x['project']} | {KINDS[x['kind']][3]} "
                 f"| {x['ref']} | {x['subject'][:44]} | {x['from']} | {x['to']} |")
    L += ["", "## Создано", "", "| Время | Человек | Проект | Род | # | Название |", "|---|---|---|---|---:|---|"]
    for x in sorted(created, key=lambda z: z["at"]):
        L.append(f"| {loc(x['at']):%d.%m %H:%M} | {x['who']} | {x['project']} | {KINDS[x['kind']][3]} "
                 f"| {x['ref']} | {x['subject'][:48]} |")

    w = auth_warn(send=True)
    if w: L.insert(3, f"> ⚠ {w}\n")
    rd = reports_dir()
    rd.mkdir(parents=True, exist_ok=True)
    out = rd / f"Отчёт_Taiga_{start_l:%Y-%m-%d}.md"
    out.write_text("\n".join(L) + "\n")
    if not args.no_triage:
        import io, contextlib
        buf = io.StringIO()
        ns = argparse.Namespace(all=True, days="1", comment=False, project=None,
                                yes=True, kind=None, dry=False)
        with contextlib.redirect_stdout(buf):
            try: cmd_triage(ns)
            except SystemExit: pass
        with out.open("a") as fh:
            fh.write("\n## Триаж: что из нового непригодно для работы\n\n"
                     "Проверка оформления созданного за сутки. Комментарии в трекер не ставятся.\n\n"
                     "```\n" + buf.getvalue().replace("(отчёт; комментарии в трекер не ставились "
                     "— для этого ключ --comment)\n", "") + "```\n")
    ok(f"{out}")
    ok(f"создано {tot[0]}, взято {tot[1]}, закрыто {tot[2]}, переходов {tot[3]}")
    if sys.platform == "darwin" and not args.quiet:
        notify("Taiga: отчёт готов", f"За {title}: создано {tot[0]}, закрыто {tot[2]}")
    return out


# ── Telegram: персональные сводки ───────────────────────────────────────────
# Один бот, у каждого получателя свой чат. Токен — в отдельном файле с правами
# 600, в конфиге только путь. Бот не может написать первым: человек должен сам
# начать диалог, и это же служит его согласием на рассылку.
TG_TOKEN_FILE = HOME / ".taiga-kit" / "telegram.token"

# ── оформление строк в сообщениях ───────────────────────────────────────────
def st_icon(status):
    """Значок по колонке. В списке из десяти карточек глаз цепляется
    за значок раньше, чем успевает прочитать название статуса."""
    t = (status or "").lower()
    if "bug" in t or "баг" in t:                       return "\U0001F41E"   # 🐞
    if "todo" in t or "to do" in t or "к работе" in t: return "\U0001F4CB"   # 📋
    if "progress" in t or "работе" in t:               return "\u25B6"       # ▶
    if "test" in t or "тест" in t:                     return "\U0001F9EA"   # 🧪
    return "\u2022"                                                          # •

def cut(t, n=120):
    """Обрезать по границе слова. «нет соо» читателю не говорит ничего —
    лучше потерять слово целиком и честно поставить многоточие."""
    t = " ".join((t or "").split())
    if len(t) <= n: return t
    head = t[:n].rsplit(" ", 1)[0]
    return (head or t[:n]).rstrip(" ,;:.—-") + "…"

def tg_token():
    p = pathlib.Path(os.path.expanduser(cfg_load().get("telegram_token_file", str(TG_TOKEN_FILE))))
    if not p.is_file() or not p.read_text().strip():
        die(f"нет токена бота ({p}). Создайте бота у @BotFather и положите токен туда")
    return p.read_text().strip()

def tg_call(method, payload=None, timeout=30):
    url = f"https://api.telegram.org/bot{tg_token()}/{method}"
    data = json.dumps(payload).encode() if payload else None
    r = urllib.request.Request(url, data=data, method="POST" if data else "GET")
    if data: r.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(r, timeout=timeout) as x: return json.loads(x.read().decode())
    except urllib.error.HTTPError as e:
        try: return json.loads(e.read().decode())
        except Exception: return {"ok": False, "description": f"HTTP {e.code}"}
    except Exception as e: return {"ok": False, "description": str(e)}


# ── команды боту: человек подписывается сам ─────────────────────────────────
# Рассылка идёт с машины администратора, поэтому выбор проектов не может
# лежать у человека на компьютере — центральное задание его не увидит. Общий
# канал, который есть у обеих сторон, один: бот.
TG_HELP = (
    "Я присылаю карточки, пришедшие на проверку.\n\n"
    "Команды:\n"
    "проекты domcom, checkpoint — следить за этими проектами\n"
    "проекты все — за всеми\n"
    "проекты — показать, за чем слежу сейчас\n"
    "сразу / вечером — переключить режим\n"
    "стоп — отписаться\n"
    "проекты? — выбрать кнопками\n\n"
    "Менять можно в любой момент, просто напишите заново."
)

def subs_load(): return cfg_load().get("column_subs", {})
def subs_save(d): cfg_set("column_subs", d)

def tg_cmd(cid, text, slugs, names):
    """Разобрать сообщение от человека. Возвращает текст ответа или None."""
    t = " ".join((text or "").split())
    low = t.lower().lstrip("/")
    if not low: return None
    subs = subs_load(); me = subs.get(str(cid), {})

    if low in ("стоп", "stop", "отписка", "отписаться"):
        if subs.pop(str(cid), None) is None: return "Вы и так не подписаны."
        subs_save(subs); return "Отписал. Вернуться: напишите «проекты все»."

    if low in ("помощь", "help", "start", "старт", "?"): return TG_HELP

    if low in ("проекты?", "проекты ?", "список", "projects?", "выбрать", "режим"):
        return "__BOARD__"
    if low in ("сразу", "вечером"):
        f = "instant" if low == "сразу" else "evening"
        me = subs.get(str(cid)) or {"projects": [], "instant": False, "evening": False}
        me[f] = not bool(me.get(f, f == "instant"))
        me.setdefault("instant", False); me.setdefault("evening", False)
        if not me["instant"] and not me["evening"]:
            subs.pop(str(cid), None); subs_save(subs)
            return "Отписал: ни один режим не выбран."
        subs[str(cid)] = me; subs_save(subs)
        return ("Присылаю: "
                + ("сразу" if me["instant"] else "")
                + (" и вечером" if me["instant"] and me["evening"] else
                   "вечером" if me["evening"] else "") + ".")

    if not (low == "проекты" or low.startswith(("проекты ", "projects"))):
        return None                                   # не команда — молчим

    arg = t.split(None, 1)[1].strip() if " " in t else ""
    if not arg:
        if not me: return "Вы не подписаны. Напишите «проекты все» или перечислите слаги."
        p = me.get("projects") or []
        return ("Слежу за всеми проектами." if not p else
                "Слежу за: " + ", ".join(names.get(x, x) for x in p)) + "\nСменить: напишите заново."

    if arg.lower() in ("все", "всё", "all", "*"):
        me["projects"] = sorted(slugs); me["all"] = True
    else:
        want = [x.strip().lower() for x in re.split(r"[,\s]+", arg) if x.strip()]
        me["all"] = False
        good = [x for x in want if x in slugs]
        bad = [x for x in want if x not in slugs]
        if not good:
            return ("Таких проектов нет: " + ", ".join(bad) + "\n\nЕсть вот эти:\n"
                    + "\n".join(f"{s} — {names[s]}" for s in sorted(slugs)))
        me["projects"] = good
        if bad: me["_bad"] = bad
    me.setdefault("name", "")
    subs[str(cid)] = me; subs_save(subs)
    p = me.get("projects") or []
    ans = ("Готово. Слежу за всеми проектами."
           if not p else "Готово. Слежу за: " + ", ".join(names.get(x, x) for x in p))
    if me.pop("_bad", None): ans += "\nНе понял и пропустил: " + ", ".join(bad)
    return ans

def subs_sync(slugs, quiet=True):
    """Подтянуть список проектов у тех, кто выбрал «все». Проект завели
    вчера — сегодня он у них уже в подписке, руками трогать не надо.
    У остальных вычищаем исчезнувшие слаги, чтобы не копился мусор."""
    subs = subs_load(); changed = []
    for cid, sb in list(subs.items()):
        was = list(sb.get("projects") or [])
        now = sorted(slugs) if sb.get("all") else sorted(set(was) & set(slugs))
        if now != was:
            sb["projects"] = now; changed.append((sb.get("name") or cid, len(now) - len(was)))
    if changed:
        subs_save(subs)
        if not quiet:
            for who, d in changed: ok(f"  {who}: проектов {'+' if d > 0 else ''}{d}")
    return len(changed)

def tg_board(cid, slugs, names):
    """Текст и клавиатура выбора проектов. Нет записи в подписках — значит
    человек не подписан, и галочек нет."""
    sub = subs_load().get(str(cid))
    # Список проектов всегда явный. «Все» — не особое состояние, а просто
    # все галочки разом: кнопка должна делать видимое, иначе непонятно,
    # сработала она или нет.
    chosen = set() if sub is None else set(sub.get("projects") or [])
    allp = bool(chosen) and chosen >= set(slugs)
    # Показываем ровно то, что лежит в памяти. Раньше у неподписанного
    # кнопка рисовалась включённой, а хранилось «выключено»: нажатие её
    # включало, вид не менялся — выглядело как поломка.
    inst = bool((sub or {}).get("instant", False))
    eve = bool((sub or {}).get("evening", False))
    rows = [[{"text": "\u2705 \U0001F9EA сразу: ДА" if inst else "\u2B1C \U0001F9EA сразу: нет",
              "callback_data": "p:*inst"},
             {"text": "\u2705 \U0001F319 вечером: ДА" if eve else "\u2B1C \U0001F319 вечером: нет",
              "callback_data": "p:*eve"}]]
    row = []
    for sl in sorted(slugs):
        row.append({"text": ("✅ " if sl in chosen else "⬜ ") + names[sl][:18],
                    "callback_data": f"p:{sl}"})
        if len(row) == 2: rows.append(row); row = []
    if row: rows.append(row)
    rows.append([{"text": ("✅ Все проекты" if allp else "⬜ Все проекты"),
                  "callback_data": "p:*all"},
                 {"text": "🔄 Обновить список", "callback_data": "p:*sync"}])
    rows.append([{"text": "Отписаться", "callback_data": "p:*none"},
                 {"text": "Готово", "callback_data": "p:*done"}])
    if sub is None: head = "Отметьте проекты, за которыми следить."
    elif allp: head = "Слежу за всеми проектами."
    elif not chosen: head = "⚠ Проекты не отмечены — присылать нечего. Отметьте нужные."
    else: head = "Слежу за: " + ", ".join(names.get(x, x) for x in sorted(chosen))
    mode = ("сразу, как карточка пришла на проверку" if inst and not eve else
            "вечером, одной сводкой" if eve and not inst else
            "сразу и вечером" if inst and eve else "ничего не присылаю")
    return (head + f"\n\nПрисылаю: {mode}.\n"
            "🧪 сразу — для тестировщиков. 🌙 вечером — для руководителей.",
            {"inline_keyboard": rows})

def tg_tap(q, slugs, names):
    """Нажатие кнопки. Снял последнюю галочку — отписали: подписка
    на ноль проектов смысла не имеет и выглядела бы как поломка."""
    msg = q.get("message") or {}
    cid = (msg.get("chat") or {}).get("id")
    mid = msg.get("message_id")
    data = (q.get("data") or "")
    if not cid or not data.startswith("p:"): return
    arg = data[2:]
    subs = subs_load(); key = str(cid)
    sub = subs.get(key)
    cur = set((sub or {}).get("projects") or [])
    note = ""
    if arg == "*done":
        tg_call("answerCallbackQuery", {"callback_query_id": q["id"], "text": "Сохранено"})
        head, _ = tg_board(cid, slugs, names)
        tg_call("editMessageText", {"chat_id": cid, "message_id": mid,
                                    "text": head.split("\n\n")[0] + "\n\nМенять — «проекты?»."})
        return
    if arg in ("*inst", "*eve"):
        # Режим — это «когда присылать», а не «что выбрать». Проекты
        # остаются как были: кнопка делает ровно то, что на ней написано.
        if sub is None:
            ok_ = {"projects": [], "instant": False, "evening": False}
        else: ok_ = dict(sub)
        f = "instant" if arg == "*inst" else "evening"
        ok_[f] = not bool(ok_.get(f, False))
        if not ok_.get("instant") and not ok_.get("evening"):
            subs.pop(key, None); note = "Отписал: ни один режим не выбран"
        else:
            subs[key] = ok_
            note = ("Буду присылать сразу" if arg == "*inst" and ok_["instant"] else
                    "Не буду присылать сразу" if arg == "*inst" else
                    "Буду присылать вечером" if ok_["evening"] else "Не буду присылать вечером")
    elif arg == "*sync":
        # Список проектов мог измениться: новый завели, старый переименовали.
        if sub is None: note = "Список обновлён"
        else:
            if sub.get("all"): subs[key] = {**sub, "projects": sorted(slugs)}
            else: subs[key] = {**sub, "projects": sorted(set(sub.get("projects") or []) & set(slugs))}
            note = "Список обновлён"
    elif arg == "*all":
        full = sorted(slugs)
        on = not (set((sub or {}).get("projects") or []) >= set(slugs))
        # Флаг «все» — это намерение следить за всем, включая проекты,
        # которых ещё нет. По нему список и обновляется каждый день.
        subs[key] = {**(sub or {}), "projects": full if on else [], "all": on}
        note = "Отметил все" if on else "Снял все"
    elif arg == "*none":
        subs.pop(key, None); note = "Отписал"
    elif arg in slugs:
        cur.symmetric_difference_update({arg})
        # Ткнул конкретный — это уже не «следить за всем».
        subs[key] = {**(sub or {}), "projects": sorted(cur), "all": False}
        note = ("Добавил " if arg in cur else "Убрал ") + names.get(arg, arg)
        if not cur: note += " · проектов не осталось, присылать нечего"
    else:
        return                                      # кнопка не наша — молчим
    if key in subs:
        subs[key].setdefault("instant", True)       # по умолчанию — как тестировщику
        subs[key].setdefault("evening", False)
        if not subs[key].get("name"):
            c = msg.get("chat") or {}
            subs[key]["name"] = (" ".join(x for x in (c.get("first_name"), c.get("last_name")) if x)
                                 or c.get("username") or str(cid))
    subs_save(subs)                                 # и при отписке тоже: иначе
                                                    # удаление останется в памяти
    tg_call("answerCallbackQuery", {"callback_query_id": q["id"], "text": note})
    head, kb = tg_board(cid, slugs, names)
    tg_call("editMessageText", {"chat_id": cid, "message_id": mid, "text": head,
                                "reply_markup": kb})

TG_BEAT = HOME / ".taiga-kit" / "tgserve.beat"

def tg_busy():
    """Слушатель жив? Telegram разрешает только один getUpdates на бота:
    второй получает 409 Conflict. Поэтому разовый опрос из дозорного
    должен уступать постоянному слушателю, а не драться с ним."""
    try: return time.time() - TG_BEAT.stat().st_mtime < 180
    except Exception: return False

def tg_serve(args):
    """Длинный опрос. Нажатие кнопки Telegram живёт считанные секунды:
    разобранное через две минуты уже просрочено, и у человека вечно висит
    «загрузка». Поэтому слушаем постоянно, а не по расписанию."""
    auth()
    ok("слушаю бота; остановить — Ctrl+C")
    fresh = time.time()
    while True:
        try:
            if time.time() - fresh > 1800:            # токен живёт не вечно
                auth(); fresh = time.time()
            TG_BEAT.parent.mkdir(parents=True, exist_ok=True)
            TG_BEAT.touch()
            n, err = tg_poll(long=True)
            if err:
                print(f"telegram: {err}", file=sys.stderr); time.sleep(5)
        except KeyboardInterrupt:
            ok("остановлен"); return
        except Exception as e:
            print(f"сбой: {e}", file=sys.stderr); time.sleep(5)

def tg_poll(quiet=True, long=False):
    """Собрать написавших боту и ЗАПОМНИТЬ. Telegram держит непрочитанные
    обновления около суток: не опросили — факт подписки потерян навсегда.
    Поэтому опрос запоминает в конфиг и вызывается ежечасно дозорным."""
    import datetime
    # Смещение обязательно: без него Telegram отдаёт одни и те же сообщения
    # сутки подряд. Команда «стоп» без смещения через час отменилась бы сама.
    off = cfg_load().get("telegram_offset")
    q = [f"timeout={50 if long else 0}"] + ([f"offset={off}"] if off else [])
    d = tg_call("getUpdates?" + "&".join(q), timeout=70 if long else 30)
    if not d.get("ok"): return 0, d.get("description")
    ups = d.get("result", [])
    slugs, names = set(), {}
    if ups:
        c0, pr = api("GET", "/projects")
        for p in (pr or []): slugs.add(p["slug"]); names[p["slug"]] = p["name"]
    known = cfg_load().get("telegram_seen", {})
    new = 0; last = None
    for u in ups:
        last = max(last or 0, u.get("update_id", 0))
        if u.get("callback_query"):
            if slugs: tg_tap(u["callback_query"], slugs, names)
            continue
        m = u.get("message") or u.get("edited_message") or {}
        c = m.get("chat") or {}
        cid = c.get("id")
        if not cid: continue
        k = str(cid)
        if slugs:
            ans = tg_cmd(cid, m.get("text"), slugs, names)
            if ans == "__BOARD__":
                head, kb = tg_board(cid, slugs, names)
                tg_call("sendMessage", {"chat_id": cid, "text": head, "reply_markup": kb})
                ans = None
            if ans:
                sb = subs_load()
                if k in sb and not sb[k].get("name"):
                    sb[k]["name"] = (" ".join(x for x in (c.get("first_name"), c.get("last_name")) if x)
                                     or c.get("username") or "—")
                    subs_save(sb)
                tg_call("sendMessage", {"chat_id": cid, "text": ans})
        if k in known: continue
        known[k] = {"name": " ".join(x for x in (c.get("first_name"), c.get("last_name")) if x) or "—",
                    "username": c.get("username") or "",
                    "first_seen": datetime.datetime.now().astimezone().isoformat(timespec="seconds")}
        new += 1
        # Человек нажал Start и получил тишину — решит, что сломалось.
        # Отвечаем сразу, как только увидели подписку.
        tg_call("sendMessage", {"chat_id": cid, "text":
            "Вы подписаны на уведомления Taiga.\n\n"
            "Будет приходить:\n"
            "— утром план: что на вас открыто и что зависло\n"
            "— вечером итог: что закрыли за день\n"
            "— сразу, когда на вас назначат карточку в BUG или ToDo\n\n"
            "Тестировщикам: напишите «проекты?» — покажу список кнопками, "
            "отметите свои. Буду присылать карточки, пришедшие на проверку. "
            "«помощь» — все команды.\n\n"
            "Для остального администратор должен связать ваш чат с учётной "
            "записью Taiga — напишите ему, что подписались."})
    if new: cfg_set("telegram_seen", known)
    # Смещение двигаем ПОСЛЕДНИМ: сорвались раньше — сообщения придут снова
    # и команды применятся повторно, что безопасно. Наоборот было бы потерей.
    if last is not None: cfg_set("telegram_offset", last + 1)
    return new, None

TGPOLL_LABEL = "kz.taiga-kit.tgpoll"

def tgpoll_install(args):
    """Частый опрос бота. Нужен ради кнопок: нажатие, обработанное через час,
    выглядит как поломка. Один сетевой вызов, стоит копейки."""
    exe = str(pathlib.Path(sys.argv[0]).resolve())
    sec = max(30, int(args.every_sec))
    log = HOME / ".taiga-kit"; log.mkdir(parents=True, exist_ok=True)
    if sys.platform == "win32":
        name = "TaigaKitTgPoll"
        if args.uninstall:
            r = subprocess.run(["schtasks","/Delete","/TN",name,"/F"], capture_output=True, text=True)
            ok("расписание снято" if not r.returncode else f"schtasks: {r.stdout}{r.stderr}"); return
        r = subprocess.run(["schtasks","/Create","/TN",name,
                            "/TR",f'"{sys.executable}" "{exe}" telegram --poll',
                            "/SC","MINUTE","/MO",str(max(1, sec // 60)),"/F"],
                           capture_output=True, text=True)
        if r.returncode: die(f"schtasks: {r.stdout}{r.stderr}")
        ok(f"опрос бота поставлен: каждые {max(1, sec // 60)} мин"); return
    if sys.platform != "darwin":
        if args.uninstall: return cron_job("tgpoll", [], True)
        ok("для systemd заведите службу, которая держит запущенным:")
        ok(f"  {sys.executable} {exe} telegram --serve")
        ok("или, грубее, раз в минуту через cron (кнопки будут тормозить):")
        return cron_job("tgpoll", [("* * * * *", ["telegram", "--poll"])], False)
    plist = HOME / "Library" / "LaunchAgents" / f"{TGPOLL_LABEL}.plist"
    if args.uninstall:
        subprocess.run(["launchctl","unload",str(plist)], capture_output=True)
        if plist.exists(): plist.unlink()
        ok(f"расписание снято: {plist}"); return
    plist.parent.mkdir(parents=True, exist_ok=True)
    plist.write_text(f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>{TGPOLL_LABEL}</string>
  <key>ProgramArguments</key>
  <array><string>{sys.executable}</string><string>{exe}</string><string>telegram</string><string>--serve</string></array>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>{os.path.expanduser("~/.local/bin")}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StandardOutPath</key><string>{log}/tgpoll.log</string>
  <key>StandardErrorPath</key><string>{log}/tgpoll.log</string>
  <key>RunAtLoad</key><true/>
</dict>
</plist>
""")
    subprocess.run(["launchctl","unload",str(plist)], capture_output=True)
    r = subprocess.run(["launchctl","load",str(plist)], capture_output=True, text=True)
    if r.returncode: die(f"launchctl: {r.stderr.strip()}")
    ok(f"слушатель бота запущен: {plist}")
    ok("держится постоянно (KeepAlive); кнопки отзываются за секунду")
    ok("снять: taiga telegram --uninstall")

def cmd_telegram(args):
    if args.install or args.uninstall: return tgpoll_install(args)
    if args.serve: return tg_serve(args)
    if args.poll:
        auth()
        n, err = tg_poll()
        if err: die(f"Telegram: {err}")
        if n: ok(f"новых подписок: {n}")
        return
    if args.discover:
        n, err = tg_poll()
        if err: die(f"Telegram: {err}")
        seen = cfg_load().get("telegram_seen", {})
        rec = cfg_load().get("telegram_recipients", {})
        linked = {str(v["chat_id"]) for v in rec.values()}
        if not seen:
            ok("боту ещё никто не писал.")
            ok("Получатель должен найти бота и отправить ему любое сообщение —")
            ok("иначе бот не имеет права писать первым.")
            return
        if n: ok(f"новых с прошлой проверки: {n}\n")
        ok(f"{'CHAT_ID':<14}{'КТО В TELEGRAM':<28}{'ПОДПИСАЛСЯ':<14}СВЯЗАН С TAIGA")
        for cid, v in sorted(seen.items(), key=lambda kv: kv[1].get("first_seen","")):
            who = v["name"] + (f" @{v['username']}" if v.get("username") else "")
            tie = next((r["name"] for r in rec.values() if str(r["chat_id"]) == cid), "— нет")
            ok(f"{cid:<14}{who[:27]:<28}{v.get('first_seen','')[5:16]:<14}{tie}")
        waiting = [c for c in seen if c not in linked]
        if waiting: ok(f"\nне связаны: {len(waiting)}. Связать: taiga telegram --add \"Фамилия\" <chat_id>")
        return
    if args.add:
        name, cid = args.add
        c, users = api("GET", "/users")
        hit = [u for u in (users or []) if name.lower() in (u.get("full_name_display") or "").lower()]
        if not hit: die(f"«{name}» не найден среди людей инстанса — см. `taiga users`")
        if len(hit) > 1: die("подходят несколько: " + ", ".join(u["full_name_display"] for u in hit))
        rec = cfg_load().get("telegram_recipients", {})
        rec[str(hit[0]["id"])] = {"chat_id": int(cid), "name": hit[0]["full_name_display"]}
        cfg_set("telegram_recipients", rec)
        ok(f"связано: {hit[0]['full_name_display']} (id {hit[0]['id']}) → чат {cid}")
        return
    if args.remove:
        rec = cfg_load().get("telegram_recipients", {})
        gone = [k for k, v in rec.items() if args.remove.lower() in (v.get("name") or "").lower()]
        if not gone: die(f"«{args.remove}» в списке получателей нет")
        for k in gone: ok(f"убран: {rec.pop(k)['name']}")
        cfg_set("telegram_recipients", rec); return
    if args.test:
        rec = cfg_load().get("telegram_recipients", {})
        if not rec: die("получателей нет — см. `taiga telegram --discover`")
        for uid, v in rec.items():
            r = tg_call("sendMessage", {"chat_id": v["chat_id"],
                                        "text": "Проверка связи от taiga-kit. Если видите это — всё работает."})
            ok(f"  {v['name']:<24} {'отправлено' if r.get('ok') else 'ОШИБКА: ' + str(r.get('description'))}")
        return
    rec = cfg_load().get("telegram_recipients", {})
    tf = cfg_load().get("telegram_token_file", str(TG_TOKEN_FILE))
    ok(f"токен: {tf} {'(есть)' if pathlib.Path(os.path.expanduser(tf)).is_file() else '— НЕТ'}")
    ok(f"получателей: {len(rec)}")
    for uid, v in rec.items(): ok(f"  {v['name']:<26} чат {v['chat_id']}")
    if not rec: ok("\nдобавить: taiga telegram --discover, затем --add")


# ── персональная сводка ─────────────────────────────────────────────────────
def digest_data(uid, need_closed=False):
    """Что собрать по одному человеку: его открытое, зависшее, вчерашнее."""
    import datetime
    now = datetime.datetime.now(datetime.timezone.utc)
    TZl = datetime.datetime.now().astimezone().tzinfo
    today = datetime.datetime.now(TZl).replace(hour=0, minute=0, second=0, microsecond=0)
    prev = today - datetime.timedelta(days=1)
    while prev.weekday() >= 5: prev -= datetime.timedelta(days=1)
    w_from, w_to = prev.astimezone(datetime.timezone.utc), today.astimezone(datetime.timezone.utc)
    _d = lambda s: datetime.datetime.fromisoformat(s.replace("Z","+00:00")) if s else None

    mine, stuck, closed_y, fresh = [], [], [], []
    c, projects = api("GET", "/projects")
    for p in (projects or []):
        pid, pname = p["id"], p["name"]
        for kind, key, ep, api_name in (("us","userstories","userstory-statuses","userstory"),
                                        ("task","tasks","task-statuses","task"),
                                        ("issue","issues","issue-statuses","issue")):
            c, st = api("GET", f"/{ep}?project={pid}")
            cat = {s["id"]: (s["name"], s.get("is_closed", False)) for s in (st or [])}
            c, objs = api("GET", f"/{KINDS[kind][0]}?project={pid}", nopage=True)
            for o in (objs or []):
                nm, closed = cat.get(o["status"], ("?", False))
                age = (now - _d(o["modified_date"])).days if o.get("modified_date") else 0
                rec = {"pr": pname, "ref": o["ref"], "st": nm, "subj": o["subject"], "age": age}
                if o.get("assigned_to") == uid and not closed:
                    mine.append(rec)
                    if "progress" in nm.lower() and age >= 7: stuck.append(rec)
                cd = _d(o.get("created_date"))
                if cd and w_from <= cd < w_to and not o.get("assigned_to"): fresh.append(rec)
                # журнал читаем только для вечернего итога и только по тронутым
                # в окне: иначе это сотни запросов и минуты ожидания
                if need_closed and closed and o.get("modified_date") and _d(o["modified_date"]) >= w_from:
                    c2, h = api("GET", f"/history/{api_name}/{o['id']}")
                    for e in (h or []):
                        vd = e.get("values_diff") or {}
                        if "status" not in vd: continue
                        tm = _d(e["created_at"])
                        if not (w_from <= tm < w_to): continue
                        if (e.get("user") or {}).get("pk") == uid and cat.get(o["status"], ("",False))[1]:
                            closed_y.append(rec); break
    return {"mine": mine, "stuck": stuck, "closed": closed_y, "fresh": fresh,
            "period": f"{prev:%d.%m}"}

def digest_text(name, d, kind):
    import datetime
    L = [f"Taiga · {name} · {datetime.datetime.now().astimezone():%a %d.%m}", ""]
    if kind == "evening":
        if d["closed"]:
            L.append(f"Закрыли сегодня: {len(d['closed'])}")
            for r in d["closed"][:6]:
                L.append(f"  \u2705 {r['pr']} #{r['ref']} · {cut(r['subj'], 70)}")
        else:
            L.append("Сегодня ничего не закрыто.")
        inwork = [r for r in d["mine"] if "progress" in r["st"].lower()]
        if inwork:
            L.append("")
            L.append(f"Остаётся в работе: {len(inwork)}")
            for r in sorted(inwork, key=lambda x: -x["age"])[:5]:
                L.append(f"  \u25B6 {r['pr']} #{r['ref']} · {r['age']}д · {cut(r['subj'], 66)}")
        return "\n".join(L)
    # утро
    L.append(f"На вас открыто: {len(d['mine'])}")
    for r in sorted(d["mine"], key=lambda x: -x["age"])[:6]:
        L.append(f"  {st_icon(r['st'])} {r['pr']} #{r['ref']} · {r['st']} · {r['age']}д · "
                 f"{cut(r['subj'], 60)}")
    if len(d["mine"]) > 6: L.append(f"  …и ещё {len(d['mine'])-6}")
    if d["stuck"]:
        L += ["", f"Зависло в работе ≥7 дней: {len(d['stuck'])}"]
        for r in sorted(d["stuck"], key=lambda x: -x["age"])[:4]:
            L.append(f"  \u23F3 {r['pr']} #{r['ref']} · {r['age']}д · {cut(r['subj'], 64)}")
    if d["fresh"]:
        L += ["", f"Новые без исполнителя за {d['period']}: {len(d['fresh'])}"]
        for r in d["fresh"][:5]:
            L.append(f"  {st_icon(r['st'])} {r['pr']} #{r['ref']} · {cut(r['subj'], 68)}")
    if not d["mine"] and not d["stuck"] and not d["fresh"]:
        L.append("Ничего не требует внимания.")
    return "\n".join(L)


def digest_install(args):
    """Два задания: утренний план и вечерний итог, оба шлют всем получателям."""
    exe = str(pathlib.Path(sys.argv[0]).resolve())
    jobs = [("morning", args.at, []), ("evening", args.evening_at, ["--evening"])]
    if sys.platform == "win32":
        for name, when, extra in jobs:
            tn = f"TaigaKitDigest{name.capitalize()}"
            if args.uninstall:
                subprocess.run(["schtasks","/Delete","/TN",tn,"/F"], capture_output=True); continue
            hh, _, mm = when.partition(":")
            cmd = f'"{sys.executable}" "{exe}" digest --all --send ' + " ".join(extra)
            r = subprocess.run(["schtasks","/Create","/TN",tn,"/TR",cmd,"/SC","WEEKLY",
                                "/D","MON,TUE,WED,THU,FRI","/ST",f"{int(hh):02d}:{int(mm or 0):02d}","/F"],
                               capture_output=True, text=True)
            if r.returncode: die(f"schtasks: {r.stdout}{r.stderr}")
        ok("расписание рассылки поставлено" if not args.uninstall else "рассылка снята"); return
    if sys.platform != "darwin":
        spec = []
        for _name, at, extra in jobs:
            hh, _, mm = at.partition(":")
            spec.append((f"{int(mm or 0)} {int(hh)} * * 1-5",
                         ["digest", "--all", "--send"] + extra))
        return cron_job("digest", spec, args.uninstall)
    log = HOME / ".taiga-kit"; log.mkdir(parents=True, exist_ok=True)
    for name, when, extra in jobs:
        label = f"kz.taiga-kit.digest-{name}"
        plist = HOME / "Library" / "LaunchAgents" / f"{label}.plist"
        if args.uninstall:
            subprocess.run(["launchctl","unload",str(plist)], capture_output=True)
            if plist.exists(): plist.unlink()
            continue
        hh, _, mm = when.partition(":")
        try: hh, mm = int(hh), int(mm or 0)
        except ValueError: die(f"время в виде ЧЧ:ММ, получено «{when}»")
        days = "".join(f"    <dict><key>Weekday</key><integer>{d}</integer>"
                       f"<key>Hour</key><integer>{hh}</integer><key>Minute</key><integer>{mm}</integer></dict>\n"
                       for d in range(1, 6))
        extra_xml = "".join(f"<string>{x}</string>" for x in extra)
        plist.parent.mkdir(parents=True, exist_ok=True)
        plist.write_text(f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>{label}</string>
  <key>ProgramArguments</key>
  <array><string>{sys.executable}</string><string>{exe}</string><string>digest</string>
  <string>--all</string><string>--send</string>{extra_xml}</array>
  <key>StartCalendarInterval</key>
  <array>
{days}  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>{os.path.expanduser("~/.local/bin")}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StandardOutPath</key><string>{log}/digest.log</string>
  <key>StandardErrorPath</key><string>{log}/digest.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
""")
        subprocess.run(["launchctl","unload",str(plist)], capture_output=True)
        r = subprocess.run(["launchctl","load",str(plist)], capture_output=True, text=True)
        if r.returncode: die(f"launchctl {label}: {r.stderr.strip()}")
    if args.uninstall: ok("рассылка снята с расписания"); return
    ok(f"рассылка поставлена: будни, план в {args.at}, итог в {args.evening_at}")
    ok(f"журнал: {log}/digest.log")
    ok("снять: taiga digest --uninstall")

def cmd_digest(args):
    if args.install or args.uninstall: return digest_install(args)
    auth()
    kind = "evening" if args.evening else "morning"
    rec = cfg_load().get("telegram_recipients", {})
    if args.whoami or (not args.all and not args.to):
        uid, name = IDENTITY["id"], (IDENTITY.get("full_name_display") or IDENTITY["username"])
        targets = [(uid, name, (rec.get(str(uid)) or {}).get("chat_id"))]
    elif args.to:
        c, users = api("GET", "/users")
        hit = [u for u in (users or []) if args.to.lower() in (u.get("full_name_display") or "").lower()]
        if not hit: die(f"«{args.to}» не найден")
        if len(hit) > 1: die("подходят несколько: " + ", ".join(u["full_name_display"] for u in hit))
        u = hit[0]
        targets = [(u["id"], u["full_name_display"], (rec.get(str(u["id"])) or {}).get("chat_id"))]
    else:
        if not rec: die("получателей нет — см. `taiga telegram --discover`")
        targets = [(int(k), v["name"], v["chat_id"]) for k, v in rec.items()]

    for uid, name, chat in targets:
        txt = digest_text(name, digest_data(uid, need_closed=(kind == "evening")), kind)
        if args.send:
            if not chat:
                ok(f"{name}: чат не связан, пропущено"); continue
            r = tg_call("sendMessage", {"chat_id": chat, "text": txt,
                                        "disable_web_page_preview": True})
            ok(f"{name}: {'отправлено' if r.get('ok') else 'ОШИБКА ' + str(r.get('description'))}")
        else:
            ok("─" * 52); ok(txt); ok("")


# ── адресные уведомления: «вам назначена карточка» ──────────────────────────
# Отдельно от сводок: те по расписанию, эти по событию. Повторно об одном и том
# же не пишем — состояние хранит тройку (проект, номер, исполнитель, статус).
NOTIFY_STATE = HOME / ".taiga-kit" / "notify-state.json"

NOTIFY_LABEL = "kz.taiga-kit.notify"

def notify_install(args):
    """Расписание адресных уведомлений. Ставится ТОЛЬКО на одной машине:
    каждая копия шлёт всем получателям, две копии — два сообщения на человека."""
    exe = str(pathlib.Path(sys.argv[0]).resolve())
    h_from, h_to, every = int(args.start), int(args.end), max(1, int(args.every))
    if sys.platform == "win32":
        name = "TaigaKitNotify"
        if args.uninstall:
            r = subprocess.run(["schtasks","/Delete","/TN",name,"/F"], capture_output=True, text=True)
            ok("расписание снято" if not r.returncode else f"schtasks: {r.stdout}{r.stderr}"); return
        dw = "MON,TUE,WED,THU,FRI,SAT,SUN" if args.all_days else "MON,TUE,WED,THU,FRI"
        r = subprocess.run(["schtasks","/Create","/TN",name,
                            "/TR",f'"{sys.executable}" "{exe}" notify',
                            "/SC","WEEKLY","/D",dw,"/ST",f"{h_from:02d}:15",
                            "/RI",str(every*60),"/DU",f"{max(1,h_to-h_from):04d}:00","/F"],
                           capture_output=True, text=True)
        if r.returncode: die(f"schtasks: {r.stdout}{r.stderr}")
        ok(f"расписание поставлено: задание «{name}»"); return
    if sys.platform != "darwin":
        return cron_job("notify", [(f"15 {h_from}-{h_to}/{every} * * {cron_days(args.all_days)}",
                                    ["notify"])], args.uninstall)
    plist = HOME / "Library" / "LaunchAgents" / f"{NOTIFY_LABEL}.plist"
    if args.uninstall:
        subprocess.run(["launchctl","unload",str(plist)], capture_output=True)
        if plist.exists(): plist.unlink()
        ok(f"расписание снято: {plist}"); return
    if not (0 <= h_from <= 23 and 0 <= h_to <= 23 and h_from <= h_to):
        die("часы должны быть 0–23 и --start не позже --end")
    days = range(0, 7) if args.all_days else range(1, 6)
    hour_list = list(range(h_from, h_to + 1, every))
    # :15 — чтобы не бить по API одновременно с дозорным, который ходит в :05
    hours = "".join(f"    <dict><key>Weekday</key><integer>{d}</integer>"
                    f"<key>Hour</key><integer>{h}</integer><key>Minute</key><integer>15</integer></dict>\n"
                    for d in days for h in hour_list)
    log = HOME / ".taiga-kit"; log.mkdir(parents=True, exist_ok=True)
    plist.parent.mkdir(parents=True, exist_ok=True)
    plist.write_text(f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>{NOTIFY_LABEL}</string>
  <key>ProgramArguments</key>
  <array><string>{sys.executable}</string><string>{exe}</string><string>notify</string></array>
  <key>StartCalendarInterval</key>
  <array>
{hours}  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>{os.path.expanduser("~/.local/bin")}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StandardOutPath</key><string>{log}/notify.log</string>
  <key>StandardErrorPath</key><string>{log}/notify.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
""")
    subprocess.run(["launchctl","unload",str(plist)], capture_output=True)
    r = subprocess.run(["launchctl","load",str(plist)], capture_output=True, text=True)
    if r.returncode: die(f"launchctl: {r.stderr.strip()}")
    ok(f"расписание поставлено: {plist}")
    ok(f"{'каждый час' if every == 1 else f'каждые {every} ч'} с {h_from}:15 до {h_to}:15, "
       f"{'все дни' if args.all_days else 'по будням'}")
    ok(f"журнал: {log}/notify.log")
    ok("ставить только на одной машине: каждая копия шлёт всем получателям")
    ok("снять: taiga notify --uninstall")

def notify_save(seen):
    NOTIFY_STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = NOTIFY_STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(seen, ensure_ascii=False)); tmp.replace(NOTIFY_STATE)

def notify_columns(args, seen):
    """Рассылка по КОЛОНКЕ, а не по исполнителю.

    Тестирование у нас живёт в колонке: карточка уходит в «Ready for test»,
    а поле «исполнитель» остаётся на разработчике, который её передвинул.
    Поэтому обычное «вам назначена карточка» тестировщика не достаёт — он
    нигде не исполнитель. Здесь следим за колонкой и шлём названным людям."""
    cols = cfg_load().get("notify_columns", {})
    if not cols: return 0
    rec = cfg_load().get("telegram_recipients", {})
    by_name = {(v.get("name") or "").lower(): v for v in rec.values()}
    want = {k.strip().lower(): v for k, v in cols.items()}
    based = set(seen.get("__col_baselined__") or [])
    c, users = api("GET", "/users")
    un = {u["id"]: (u.get("full_name_display") or u.get("username")) for u in (users or [])}
    c, projects = api("GET", "/projects")
    k = subs_sync({p["slug"] for p in (projects or [])})
    if k: ok(f"подписки свёрены со списком проектов: изменилось {k}")
    fresh = {}
    for p in (projects or []):
        pid, pslug, pname = p["id"], p["slug"], p["name"]
        for kind, ep, web in (("us","userstory-statuses","us"),
                              ("task","task-statuses","task"),
                              ("issue","issue-statuses","issue")):
            c, st = api("GET", f"/{ep}?project={pid}")
            names = {x["id"]: x["name"] for x in (st or [])}
            hit = {i: n for i, n in names.items() if n.strip().lower() in want}
            if not hit: continue
            c, objs = api("GET", f"/{KINDS[kind][0]}?project={pid}", nopage=True)
            for o in (objs or []):
                if o["status"] not in hit: continue
                col = hit[o["status"]]
                key = f"col:{pslug}/{kind}/{o['ref']}/{col}"
                if key in seen: continue
                fresh.setdefault(col.strip().lower(), []).append({
                    "key": key, "col": col, "pr": pname, "slug": pslug, "ref": o["ref"],
                    "subj": o["subject"], "holder": un.get(o.get("assigned_to"), "не назначена"),
                    "url": f"{base()}/project/{pslug}/{web}/{o['ref']}"})
    sent = 0
    for col_l, items in fresh.items():
        col = items[0]["col"]
        # Первый прогон по колонке: в «Ready for test» лежит под сотню карточек,
        # и люди получили бы их все разом. Помечаем известными молча.
        if col_l not in based:
            for x in items: seen[x["key"]] = True
            based.add(col_l); seen["__col_baselined__"] = sorted(based)
            notify_save(seen)
            ok(f"колонка «{col}»: впервые в рассылке — {len(items)} карточек "
               f"помечены как известные, сообщений не шлю")
            continue
        # Два источника получателей: список администратора (по именам в Taiga,
        # без разбора проектов) и самоподписка через бота (со своим набором).
        targets = []
        for nm in want[col_l]:
            t = by_name.get(nm.lower()) or next(
                (v for k, v in by_name.items() if nm.lower() in k), None)
            # None — «все проекты»: список администратора не фильтруется.
            if t: targets.append({"chat_id": t["chat_id"], "name": t["name"], "projects": None})
            else: ok(f"колонка «{col}»: «{nm}» не подключён к боту — пропускаю")
        have = {t["chat_id"] for t in targets}
        for cid, sb in subs_load().items():
            if int(cid) in have: continue
            if not sb.get("instant", True): continue      # он подписан только на вечер
            targets.append({"chat_id": int(cid), "name": sb.get("name") or cid,
                            "projects": list(sb.get("projects") or [])})
        if not targets:
            # Отметку ставим всё равно: иначе первый подписавшийся получит
            # всё, что накопилось, пока получателей не было.
            for x in items: seen[x["key"]] = True
            notify_save(seen)
            ok(f"колонка «{col}»: получателей нет, {len(items)} карточек помечены без отправки")
            continue
        items.sort(key=lambda x: -x["ref"])
        def compose(part):
            if len(part) <= 3:
                return [f"\U0001F9EA В «{col}» · {x['pr']} #{x['ref']}\n{cut(x['subj'], 110)}\n"
                        f"от: {x['holder']}\n{x['url']}" for x in part]
            L = [f"\U0001F9EA В «{col}» новых карточек: {len(part)}", ""]
            for x in part[:15]:
                L += [f"{x['pr']} #{x['ref']} · {cut(x['subj'], 70)}", x["url"], ""]
            if len(part) > 15: L.append(f"…и ещё {len(part)-15}")
            return ["\n".join(L).strip()]
        touched = False
        for t in targets:
            mine = (items if t["projects"] is None
                    else [x for x in items if x["slug"] in t["projects"]])
            if not mine:
                ok(f"  колонка «{col}» → {t['name']}: "
                   + ("проекты не отмечены" if t["projects"] == [] else "ничего по его проектам"))
                continue
            okall = True
            for txt in compose(mine):
                r = tg_call("sendMessage", {"chat_id": t["chat_id"], "text": txt,
                                            "disable_web_page_preview": True})
                if not r.get("ok"):
                    okall = False
                    ok(f"  {t['name']}: ОШИБКА {r.get('description')}")
            if okall:
                touched = True
                ok(f"  колонка «{col}» → {t['name']}: {len(mine)} шт."
                   + ("" if t["projects"] is None else f" (из {len(items)})"))
        for x in items: seen[x["key"]] = True
        if touched: sent += len(items)
        notify_save(seen)
    return sent

def cmd_notify(args):
    if args.install or args.uninstall: return notify_install(args)
    if args.column:
        cols = cfg_load().get("notify_columns", {})
        if args.watchers is None and not args.off:
            if args.column not in cols:
                ok(f"колонка «{args.column}»: не под наблюдением"); return
            adm = cols[args.column]
            sb = subs_load()
            ok(f"колонка «{args.column}» под наблюдением")
            ok(f"  список администратора: {', '.join(adm) if adm else 'пуст'}")
            ok(f"  подписались сами: {len(sb)}")
            for cid, v in sb.items():
                p = v.get("projects") or []
                ok(f"    {v.get('name') or cid}: {'все проекты' if not p else ', '.join(p)}")
            return
        if args.off:
            cols.pop(args.column, None); cfg_set("notify_columns", cols)
            ok(f"колонка «{args.column}»: больше не следим"); return
        # Пустой список — колонка ПОД наблюдением, просто без списка от
        # администратора: получатели приходят из самоподписки через бота.
        # Снять наблюдение совсем — отдельный ключ --off, иначе легко
        # выключить рассылку, думая что просто убираешь людей.
        names = [x.strip() for x in args.watchers.split(",") if x.strip()]
        cols[args.column] = names
        cfg_set("notify_columns", cols)
        n = len(subs_load())
        ok(f"колонка «{args.column}»: " + (", ".join(names) if names else
           f"список администратора пуст, получатели только из самоподписки (сейчас их {n})"))
        return
    auth()
    rec = cfg_load().get("telegram_recipients", {})
    if not rec: die("получателей нет — см. `taiga telegram --discover`")
    want = {s.lower() for s in cfg_load().get("watch_statuses", ["BUG","Bug (reopen)","ToDo"])}
    seen = {}
    if NOTIFY_STATE.is_file():
        try: seen = json.loads(NOTIFY_STATE.read_text())
        except json.JSONDecodeError: seen = {}
    based = set(seen.get("__baselined__") or [])

    c, projects = api("GET", "/projects")
    fresh, sent, skipped = [], 0, 0
    for p in (projects or []):
        pid, pname, pslug = p["id"], p["name"], p["slug"]
        for kind, ep, web in (("us","userstory-statuses","us"),
                              ("task","task-statuses","task"),
                              ("issue","issue-statuses","issue")):
            c, st = api("GET", f"/{ep}?project={pid}")
            names = {s["id"]: s["name"] for s in (st or [])}
            if not (want & {n.lower() for n in names.values()}): continue
            c, objs = api("GET", f"/{KINDS[kind][0]}?project={pid}", nopage=True)
            for o in (objs or []):
                a = o.get("assigned_to")
                if not a or str(a) not in rec: continue
                nm = names.get(o["status"], "")
                if nm.lower() not in want: continue
                key = f"{pslug}/{kind}/{o['ref']}/{a}/{o['status']}"
                if key in seen: skipped += 1; continue
                fresh.append({"key": key, "uid": str(a), "name": rec[str(a)]["name"],
                              "chat": rec[str(a)]["chat_id"], "pr": pname,
                              "ref": o["ref"], "st": nm, "kind": kind,
                              "subj": o["subject"],
                              "url": f"{base()}/project/{pslug}/{web}/{o['ref']}"})

    if args.baseline:
        for x in fresh: seen[x["key"]] = True
        seen["__baselined__"] = sorted(based | set(rec))
        notify_save(seen)
        ok(f"отсечка поставлена: {len(fresh)} уже назначенных карточек помечены как известные.")
        ok("Ничего не отправлено. Уведомления пойдут только о том, что появится дальше.")
        return

    # Новичок в рассылке получил бы разом все свои открытые карточки — два
    # десятка сообщений в первую же минуту. Отсечка ему ставится сама.
    newbies = {u for u in rec if u not in based}
    if newbies and not args.dry:
        held = [x for x in fresh if x["uid"] in newbies]
        for x in held: seen[x["key"]] = True
        seen["__baselined__"] = sorted(based | newbies)
        notify_save(seen)
        for u in sorted(newbies):
            n = len([x for x in held if x["uid"] == u])
            ok(f"{rec[u]['name']}: впервые в рассылке — {n} уже назначенных карточек "
               f"помечены как известные, сообщений не шлю")
        fresh = [x for x in fresh if x["uid"] not in newbies]
    if not fresh:
        ok(f"новых назначений нет (уже отмечено: {skipped})")
        if not args.dry: notify_columns(args, seen)
        return
    if not args.dry: notify_columns(args, seen)
    byuser = {}
    for x in fresh: byuser.setdefault(x["uid"], []).append(x)
    for uid, items in byuser.items():
        who = items[0]["name"]
        if len(items) > int(args.max):
            # Падать нельзя: это задание по расписанию, и останов лишил бы
            # уведомлений всех остальных. Пропускаем одного, отметку не ставим.
            ok(f"{who}: к отправке {len(items)} — больше порога {args.max}, пропускаю. "
               f"Посмотреть: taiga notify --dry")
            continue
        head = "Вам назначена карточка:" if len(items) == 1 else f"Вам назначено карточек: {len(items)}"
        lines = [head, ""]
        for x in items[:10]:
            lines.append(f"{st_icon(x['st'])} {x['pr']} #{x['ref']} · {x['st']}")
            lines.append(cut(x["subj"], 120))
            lines.append(x["url"]); lines.append("")
        if len(items) > 10: lines.append(f"…и ещё {len(items)-10}")
        txt = "\n".join(lines).strip()
        if args.dry:
            ok(f"── {who} ──"); ok(txt); ok(""); continue
        r = tg_call("sendMessage", {"chat_id": items[0]["chat"], "text": txt,
                                    "disable_web_page_preview": True})
        if r.get("ok"):
            sent += len(items)
            for x in items: seen[x["key"]] = True
            ok(f"{who}: отправлено {len(items)}")
        else:
            ok(f"{who}: ОШИБКА {r.get('description')} — отметку не ставлю, повторим позже")
    if not args.dry:
        notify_save(seen)
        ok(f"\nразослано карточек: {sent}")
    else:
        ok("(сухой прогон — ничего не отправлено, отметки не поставлены)")

# ── автоматическая разведка по коду ─────────────────────────────────────────
# Дозорный кладёт заготовку, разведка её заполняет: ищет место в коде, строит
# гипотезу, предлагает шаг. Запускает `claude -p` в папке проекта с правом
# ТОЛЬКО читать. Почему так строго: в репозиториях лежат сотни несохранённых
# файлов чужой работы, и любая запись туда — чужая потеря.
RECON_STATE = HOME / ".taiga-kit" / "recon-state.json"
RECON_WAIT  = "ждёт разведки"
RECON_DONE  = "разведка готова"
RECON_FAIL  = "разведка не удалась"
# Слова, которых разведка права не имеет: она читала код, но не запускала его.
RECON_BAD = ("подтвердил", "подтвердила", "воспроизвёл", "воспроизвела", "воспроизвел",
             "причина в том", "причина в ", "баг вызван", "ошибка вызвана")

RECON_PROMPT = """Ты разбираешь тикет трекера по коду этого репозитория. Только чтение.

ТИКЕТ
{subject}
{url}
статус: {st} · исполнитель: {who}

{desc}

ЧТО СДЕЛАТЬ
Найди в коде место, которого касается тикет. Ответь РОВНО тремя разделами
в таком виде, без вступления и без заключения:

## Что нашлось в коде
- путь/к/файлу.ext:НОМЕР — что там происходит
(от двух до шести пунктов; ссылайся только на файлы, которые ты действительно открыл)

## Гипотеза
(два–пять предложений)

## Что предлагаю
(один–четыре пункта: конкретный следующий шаг)

ПРАВИЛА
- Ты не собирал приложение и не воспроизводил баг. Пиши «судя по коду»,
  «предположительно». Не пиши «подтвердил», «воспроизвёл», «причина в».
- Не меняй ни одного файла и не трогай git: в репозитории чужая работа в процессе.
- Не нашёл — так и напиши, где искал и почему. Выдуманная ссылка на файл хуже
  честного «не нашёл»: по ней пойдут и потеряют время.
"""

def recon_state():
    import datetime
    today = datetime.date.today().isoformat()
    d = {}
    if RECON_STATE.is_file():
        try: d = json.loads(RECON_STATE.read_text())
        except json.JSONDecodeError: d = {}
    if d.get("day") != today: d = {"day": today, "done": 0}
    return d

def recon_save(d):
    RECON_STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = RECON_STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(d, ensure_ascii=False)); tmp.replace(RECON_STATE)

def recon_stubs(reg, only_slug=None, only_ref=None):
    """Заготовки, ждущие разведки. Правленые человеком не берём: статус в них
    уже не «ждёт разведки», и перезаписать его значило бы стереть чужую работу."""
    out = []
    for slug in sorted(reg):
        if only_slug and slug != only_slug: continue
        folder = reg_path(slug)
        tri = (folder / ".claude" / "триаж") if folder else None
        if not (tri and tri.is_dir()): continue
        for fn in tri.glob("*.md"):
            txt = fn.read_text(errors="ignore")
            if f"статус: {RECON_WAIT}" not in txt: continue
            m = re.match(r"(\d+)-", fn.name)
            if not m: continue
            ref = int(m.group(1))
            if only_ref and ref != only_ref: continue
            m2 = re.search(r"исполнитель: (.+)$", txt, re.M)
            who = (m2.group(1).strip() if m2 else "")
            mine = bool(who) and who != "не назначена"
            out.append({"slug": slug, "root": folder, "file": fn, "ref": ref,
                        "text": txt, "who": who, "assigned": mine})
    # Назначенные вперёд: у них есть кому читать разбор сегодня. Ничьи ждут —
    # их всё равно сначала кому-то отдадут. Внутри каждой кучки — свежие вперёд.
    out.sort(key=lambda x: (not x["assigned"], -x["ref"]))
    return out

# launchd и cron дают почти пустой PATH: «claude» там не найдётся, и
# разведка молча падала каждый час. Ищем сами, по тем местам, куда его
# реально ставят.
EXE_DIRS = ["~/.local/bin", "/opt/homebrew/bin", "/usr/local/bin",
            "~/.claude/local", "~/.bun/bin", "~/.npm-global/bin", "/usr/bin",
            "~/AppData/Roaming/npm", "~/AppData/Local/Programs/claude"]

def find_exe(name):
    p = shutil.which(name)
    if p: return p
    for d in EXE_DIRS:
        for suf in ("", ".cmd", ".exe"):
            c = pathlib.Path(os.path.expanduser(d)) / (name + suf)
            if c.exists(): return str(c)
    return None

CLAUDE_TOKEN_FILE = HOME / ".taiga-kit" / "claude.token"

def claude_token():
    p = pathlib.Path(os.path.expanduser(cfg_load().get("claude_token_file",
                                                       str(CLAUDE_TOKEN_FILE))))
    try: return p.read_text().strip() or None
    except Exception: return None

def recon_env():
    """Окружение для дочернего claude. Переменные нашей сессии ему вредят:
    ANTHROPIC_BASE_URL указывает на прокси, обновлять токен к которому умеет
    только десктопное приложение."""
    e = dict(os.environ)
    for k in list(e):
        if k.startswith(("CLAUDE", "ANTHROPIC_BASE_URL", "ANTHROPIC_AUTH")): e.pop(k, None)
    # Долгоживущий токен кладём ПОСЛЕ очистки: иначе его бы стёрло вместе
    # с остальными CLAUDE*. Без него вход зависит от десктопного приложения
    # и слетает при каждом его перезапуске.
    t = claude_token()
    if t: e["CLAUDE_CODE_OAUTH_TOKEN"] = t
    return e

def recon_run(stub, timeout, cmd, model=None):
    """Запустить разведку по одной заготовке. Возвращает (текст, ошибка)."""
    t = stub["text"]
    g = lambda pat, d="": (re.search(pat, t, re.M).group(1).strip()
                           if re.search(pat, t, re.M) else d)
    body = t.split("## Что в тикете", 1)[-1].split("## Чего не хватает", 1)[0].strip()
    prompt = RECON_PROMPT.format(
        subject=g(r"^# (.+)$", f"#{stub['ref']}"),
        url=g(r"^(https?://\S+)$"),
        st=g(r"статус в трекере: (.+?) ·", "?"),
        who=g(r"исполнитель: (.+)$", "?"),
        desc=body or "_описания в тикете нет_")
    exe = find_exe(cmd) or cmd
    argv = [exe, "-p", "--allowedTools", "Read", "Grep", "Glob",
            "--permission-mode", "default", "--max-turns", "20"]
    if model: argv += ["--model", model]
    try:
        r = subprocess.run(argv, input=prompt, capture_output=True, text=True,
                           cwd=str(stub["root"]), timeout=timeout, env=recon_env())
    except subprocess.TimeoutExpired:
        return None, f"не уложилась в {timeout} с"
    except FileNotFoundError:
        return None, (f"программа «{cmd}» не найдена. Искал в PATH и в "
                      + ", ".join(EXE_DIRS[:4]) + ". Задайте путь: recon_cmd в конфиге")
    out = (r.stdout or "").strip()
    if r.returncode != 0:
        return None, ((r.stderr or out).strip().splitlines() or ["код " + str(r.returncode)])[0][:200]
    if len(out) < 80: return None, "ответ пустой или слишком короткий"
    if "## Гипотеза" not in out: return None, "в ответе нет раздела «Гипотеза»"
    return out, None

def recon_check(out, root):
    """Проверить ответ: существуют ли названные файлы и нет ли запрещённых слов.
    Проверяем механически, потому что выдуманная ссылка выглядит убедительно."""
    bad_refs, seen = [], set()
    for m in re.finditer(r"([\w./\-]+\.[A-Za-z0-9]{1,6}):(\d+)", out):
        p = m.group(1)
        if p in seen: continue
        seen.add(p)
        if (root / p).exists(): continue
        name = pathlib.PurePath(p).name
        try: found = next(root.rglob(name), None)
        except Exception: found = None
        if not found: bad_refs.append(f"{p}:{m.group(2)}")
    low = out.lower()
    words = sorted({w.strip() for w in RECON_BAD if w in low})
    return bad_refs, words

def recon_apply(stub, out, bad_refs, words):
    """Вписать разведку в заготовку, сохранив шапку и текст тикета."""
    import datetime
    t = stub["text"]
    head = t.split("## Что нашлось в коде", 1)[0].rstrip()
    warn = []
    if bad_refs:
        warn.append("> ⚠ не найдено в репозитории: " + ", ".join(bad_refs[:6])
                    + ". Ссылкам из этого списка верить нельзя.")
    if words:
        warn.append("> ⚠ разведка написала «" + "», «".join(words)
                    + "», хотя приложение не запускала. Читайте как предположение.")
    tail = "\n".join(warn) + ("\n\n" if warn else "")
    body = (f"{head}\n\n{tail}{out.strip()}\n\n"
            f"_Разведка по коду, {datetime.date.today().isoformat()}. "
            f"Не проверено запуском._\n")
    return re.sub(r"^статус: .+$", f"статус: {RECON_DONE}", body, count=1, flags=re.M)

def recon_gist(out, n=3):
    """Пара строк для сообщения: гипотеза, если она есть."""
    m = re.search(r"## Гипотеза\s*\n(.+?)(?=\n## |\Z)", out, re.S)
    txt = " ".join((m.group(1) if m else out).split())
    return cut(txt, 300)

def cmd_recon(args):
    import datetime
    if args.install or args.uninstall: return recon_install(args)
    if args.token:
        # Ввод скрытый и из терминала: в переписке и в истории команд
        # токену не место. Файл — только для владельца.
        if not sys.stdin.isatty(): die("ввод токена требует терминала")
        v = getpass.getpass("Токен от `claude setup-token` (ввод не виден): ").strip()
        if not v: die("пусто — ничего не записано")
        write_secret(CLAUDE_TOKEN_FILE, v)
        ok(f"токен записан: {CLAUDE_TOKEN_FILE} (права 600)")
        ok("проверка:  taiga recon --dry")
        return
    reg = reg_load()
    if not reg: die("реестр пуст — выполните `taiga registry --scan`")
    cfg = cfg_load()
    cmd = cfg.get("recon_cmd", "claude")
    model = cfg.get("recon_model")
    timeout = int(cfg.get("recon_timeout", 300))
    per_day = int(args.max_day if args.max_day else cfg.get("recon_max_day", 10))
    per_run = int(args.max_run if args.max_run else cfg.get("recon_max_run", 3))

    stubs = recon_stubs(reg, args.project, int(args.ref) if args.ref else None)
    stt = recon_state()
    left = max(0, per_day - int(stt.get("done", 0)))
    if not stubs:
        ok("заготовок, ждущих разведки, нет"); return
    if not left and not args.ref:
        ok(f"дневной предел исчерпан: {stt['done']} из {per_day}. "
           f"Ждут разведки: {len(stubs)}"); return
    take = stubs if args.ref else stubs[:min(per_run, left)]

    ok(f"ждут разведки: {len(stubs)} · сегодня сделано {stt.get('done',0)} из {per_day} · "
       f"беру {len(take)}")
    if args.dry:
        for s in take: ok(f"  {s['slug']} #{s['ref']} · {s['file'].name}")
        ok(f"\n(сухой прогон — модель не запускалась)\n"
           f"команда: {cmd} -p --allowedTools Read Grep Glob --max-turns 20, "
           f"предел {timeout} с, папка проекта")
        return

    done = []; errs = []
    for s in take:
        t0 = time.time()
        out, err = recon_run(s, timeout, cmd, model)
        secs = int(time.time() - t0)
        if err:
            errs.append(err)
            ok(f"  {s['slug']} #{s['ref']}: не вышло — {err}")
            # Отметку дня не тратим на неудачу: иначе одна сломанная настройка
            # съест весь дневной предел и разведка встанет до завтра.
            continue
        bad, words = recon_check(out, s["root"])
        s["file"].write_text(recon_apply(s, out, bad, words))
        # Разбор по прямой просьбе человека дневной предел не ест: предел
        # сдерживает автоматику, а не людей. Ключ --ref это и обещает.
        if not args.ref:
            stt["done"] = int(stt.get("done", 0)) + 1
            recon_save(stt)
        flags = (f" · ⚠ выдуманных ссылок: {len(bad)}" if bad else "") + \
                (f" · ⚠ запрещённые слова: {len(words)}" if words else "")
        ok(f"  {s['slug']} #{s['ref']}: готово за {secs} с{flags}")
        done.append((s, out, bad, words))

    # Беззвучное падение опаснее самого падения: разведка так простояла
    # четыре дня, а снаружи это выглядело как «просто нет новых разборов».
    # Поэтому о двух подряд неудачных прогонах сообщаем, но не чаще раза в день.
    import datetime as _dt
    today = _dt.date.today().isoformat()
    if errs and not done:
        stt["fails"] = int(stt.get("fails", 0)) + 1
        stt["last_error"] = errs[0][:200]
        if stt["fails"] >= 2 and stt.get("alerted") != today:
            stt["alerted"] = today
            msg = (f"Разведка не работает: {errs[0][:160]}\n"
                   f"Неудачных прогонов подряд: {stt['fails']}. "
                   f"Ждут разбора: {len(stubs)}.")
            notify("Taiga: разведка встала", msg)
            rec = cfg_load().get("telegram_recipients", {})
            me = rec.get(str((IDENTITY or {}).get("id")))
            if me: tg_call("sendMessage", {"chat_id": me["chat_id"], "text": "⚠ " + msg})
            ok("  о поломке сообщено: уведомление и Telegram")
        recon_save(stt)
    elif done:
        if stt.get("fails"):
            ok(f"  разведка снова работает (до этого неудачных прогонов: {stt['fails']})")
        stt["fails"] = 0; stt.pop("last_error", None); recon_save(stt)

    if args.send and done:
        recon_send(done)
    if done:
        notify("Taiga: разведка", f"Разобрано тикетов: {len(done)}")
    ok(f"разобрано: {len(done)} · остаток дневного предела: "
       f"{max(0, per_day - int(stt.get('done', 0)))}")

def recon_send(done):
    """Разослать итог тем, на кого тикет назначен и кто подключён к боту."""
    rec = cfg_load().get("telegram_recipients", {})
    if not rec: ok("  получателей нет — не рассылаю"); return
    by_name = {(v.get("name") or "").lower(): v for v in rec.values()}
    for s, out, bad, words in done:
        who = (re.search(r"исполнитель: (.+)$", s["text"], re.M) or [None, ""])[1].strip()
        tgt = by_name.get(who.lower()) or next(
            (v for k, v in by_name.items() if who and (who.lower() in k or k in who.lower())), None)
        if not tgt:
            ok(f"  #{s['ref']}: «{who or 'не назначена'}» не подключён к боту — не отправлено")
            continue
        subj = (re.search(r"^# (.+)$", s["text"], re.M) or [None, ""])[1].strip()
        url = (re.search(r"^(https?://\S+)$", s["text"], re.M) or [None, ""])[1].strip()
        lines = [f"\U0001F50E Разведка по коду · #{s['ref']}", cut(subj, 110), "",
                 recon_gist(out)]
        if bad: lines += ["", f"⚠ выдуманные ссылки на файлы: {len(bad)} — проверяйте"]
        lines += ["", url, f"Полностью: {s['file']}"]
        r = tg_call("sendMessage", {"chat_id": tgt["chat_id"], "text": "\n".join(lines),
                                    "disable_web_page_preview": True})
        ok(f"  #{s['ref']} → {tgt['name']}: "
           f"{'отправлено' if r.get('ok') else 'ОШИБКА ' + str(r.get('description'))}")

RECON_LABEL = "kz.taiga-kit.recon"

def recon_install(args):
    exe = str(pathlib.Path(sys.argv[0]).resolve())
    h_from, h_to, every = int(args.start), int(args.end), max(1, int(args.every))
    if sys.platform == "win32":
        name = "TaigaKitRecon"
        if args.uninstall:
            r = subprocess.run(["schtasks","/Delete","/TN",name,"/F"], capture_output=True, text=True)
            ok("расписание снято" if not r.returncode else f"schtasks: {r.stdout}{r.stderr}"); return
        r = subprocess.run(["schtasks","/Create","/TN",name,
                            "/TR",f'"{sys.executable}" "{exe}" recon --send',
                            "/SC","WEEKLY","/D","MON,TUE,WED,THU,FRI","/ST",f"{h_from:02d}:35",
                            "/RI",str(every*60),"/DU",f"{max(1,h_to-h_from):04d}:00","/F"],
                           capture_output=True, text=True)
        if r.returncode: die(f"schtasks: {r.stdout}{r.stderr}")
        ok(f"расписание поставлено: «{name}»"); return
    if sys.platform != "darwin":
        return cron_job("recon", [(f"35 {h_from}-{h_to}/{every} * * 1-5",
                                   ["recon", "--send"])], args.uninstall)
    plist = HOME / "Library" / "LaunchAgents" / f"{RECON_LABEL}.plist"
    if args.uninstall:
        subprocess.run(["launchctl","unload",str(plist)], capture_output=True)
        if plist.exists(): plist.unlink()
        ok(f"расписание снято: {plist}"); return
    log = HOME / ".taiga-kit"; log.mkdir(parents=True, exist_ok=True)
    plist.parent.mkdir(parents=True, exist_ok=True)
    hours = "".join(f"    <dict><key>Weekday</key><integer>{d}</integer>"
                    f"<key>Hour</key><integer>{h}</integer><key>Minute</key><integer>35</integer></dict>\n"
                    for d in range(1, 6) for h in range(h_from, h_to + 1, every))
    plist.write_text(f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>{RECON_LABEL}</string>
  <key>ProgramArguments</key>
  <array><string>{sys.executable}</string><string>{exe}</string><string>recon</string><string>--send</string></array>
  <key>StartCalendarInterval</key>
  <array>
{hours}  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>{os.path.expanduser("~/.local/bin")}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StandardOutPath</key><string>{log}/recon.log</string>
  <key>StandardErrorPath</key><string>{log}/recon.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
""")
    subprocess.run(["launchctl","unload",str(plist)], capture_output=True)
    r = subprocess.run(["launchctl","load",str(plist)], capture_output=True, text=True)
    if r.returncode: die(f"launchctl: {r.stderr.strip()}")
    ok(f"расписание поставлено: {plist}")
    ok(f"будни, каждые {every} ч с {h_from}:35 до {h_to}:35 · "
       f"до {cfg_load().get('recon_max_run', 3)} тикетов за раз, "
       f"{cfg_load().get('recon_max_day', 10)} в сутки")
    ok(f"журнал: {log}/recon.log")
    ok("снять: taiga recon --uninstall")


# ── еженедельные карточки встреч руководителей ──────────────────────────────
# Было отдельным скриптом с собственной обвязкой и собственным заданием,
# хотя всё, что он делал, — звал `taiga apply`. Перенесено сюда: одна
# программа, одно расписание, один журнал.
RITUAL_PM = ["Владимир Меньшагин", "Михаил Степанов", "Михаил Чечушков", "Мурат Омаров"]
RITUAL_DAYS = ["пн", "вт", "ср", "чт", "пт"]

LINKS = """Задачи — ссылками на карточки Taiga (адрес из строки браузера).
Голый номер не годится: #268 есть в нескольких проектах."""

PLANNING = """Еженедельное планирование с командой (понедельник).

Цели недели:

### Участник: ____________
- [название задачи](ссылка) — срок

### Участник: ____________
- [название задачи](ссылка) — срок

Риски:

""" + LINKS

MEMBER_BLOCK = """### Участник: ____________
1. Сделано:
2. План:
3. Вопросы:
"""

DAILY = """Ежедневный чек-статус с командой.
Блок на каждого участника созвона: лишние удалите, недостающие скопируйте.
Имя — как в Taiga. Нечего писать — поставьте тире, пункт не удаляйте.

""" + "\n".join([MEMBER_BLOCK] * 5) + """
### Итоги созвона
- Решения:
- Блокеры и кто их снимает:

""" + LINKS + """

Пункт «План» разбирается автоматически для вечерней сводки «план против факта» —
он должен состоять из ссылок. Регламент: РЕГЛАМЕНТ-карточек-PM.md
В Done — после того, как дейлик проведён и карточка заполнена."""

RETRO = """Еженедельная ретроспектива (пятница).

- что сделано;
- что не сделано и по какой причине;
- выводы и действия на следующую неделю."""



RITUAL_LABEL = "kz.taiga-kit.rituals"

def ritual_plan(mon, managers, slug):
    fmt = lambda d: d.strftime("%d.%m.%Y")
    import datetime
    stories = []
    for pm in managers:
        stories.append({"subject": f"Планирование недели {fmt(mon)} — {pm}",
                        "description": PLANNING, "assign": pm})
        for i, name in enumerate(RITUAL_DAYS):
            d = mon + datetime.timedelta(days=i)
            stories.append({"subject": f"Чек-статус {name} {fmt(d)} — {pm}",
                            "description": DAILY, "assign": pm})
        stories.append({"subject": f"Ретроспектива недели {fmt(mon)} — {pm}",
                        "description": RETRO, "assign": pm})
    return {"project": slug, "stories": stories}

def cmd_rituals(args):
    import datetime
    if args.install or args.uninstall:
        exe = str(pathlib.Path(sys.argv[0]).resolve())
        if sys.platform != "darwin":
            return cron_job("rituals", [("0 8 * * 1", ["rituals"])], args.uninstall)
        plist = HOME / "Library" / "LaunchAgents" / f"{RITUAL_LABEL}.plist"
        if args.uninstall:
            subprocess.run(["launchctl","unload",str(plist)], capture_output=True)
            if plist.exists(): plist.unlink()
            ok(f"расписание снято: {plist}"); return
        log = HOME / ".taiga-kit"; log.mkdir(parents=True, exist_ok=True)
        plist.parent.mkdir(parents=True, exist_ok=True)
        plist.write_text(f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>{RITUAL_LABEL}</string>
  <key>ProgramArguments</key>
  <array><string>{sys.executable}</string><string>{exe}</string><string>rituals</string></array>
  <key>StartCalendarInterval</key>
  <array><dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>8</integer>
  <key>Minute</key><integer>0</integer></dict></array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>{os.path.expanduser("~/.local/bin")}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StandardOutPath</key><string>{log}/rituals.log</string>
  <key>StandardErrorPath</key><string>{log}/rituals.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
""")
        subprocess.run(["launchctl","unload",str(plist)], capture_output=True)
        r = subprocess.run(["launchctl","load",str(plist)], capture_output=True, text=True)
        if r.returncode: die(f"launchctl: {r.stderr.strip()}")
        ok(f"расписание поставлено: понедельник 08:00 · {plist}"); return
    auth()
    day = datetime.date.fromisoformat(args.week) if args.week else datetime.date.today()
    mon = day - datetime.timedelta(days=day.weekday())
    managers = ([x.strip() for x in args.managers.split(",") if x.strip()] if args.managers
                else cfg_load().get("ritual_managers") or RITUAL_PM)
    if args.managers: cfg_set("ritual_managers", managers)
    slug = args.project or cfg_load().get("ritual_project", "projectmanager")
    d = ritual_plan(mon, managers, slug)
    f = HOME / ".taiga-kit" / f"rituals-{mon.isoformat()}.json"
    f.parent.mkdir(parents=True, exist_ok=True)
    f.write_text(json.dumps(d, ensure_ascii=False, indent=2))
    ok(f"неделя {mon:%d.%m.%Y} · руководителей {len(managers)} · карточек {len(d['stories'])}")
    ns = argparse.Namespace(file=str(f), project=slug, yes=True, kind="us")
    return cmd_plan(ns) if args.dry else cmd_apply(ns)

def cmd_watch(args):
    import datetime
    if args.install or args.uninstall: return watch_install(args)
    auth()
    reg = reg_load()
    if not reg: die("реестр пуст — выполните `taiga registry --scan`")
    if args.filter:
        if args.filter not in ("mine", "mine+free", "all"):
            die("отбор: mine, mine+free или all")
        cfg_set("watch_filter", args.filter)
        ok(f"отбор запомнен: {args.filter}")
    if args.statuses is not None:
        v = [s.strip() for s in args.statuses.split(",") if s.strip()]
        cfg_set("watch_statuses", v)
        ok(f"отбор по статусу запомнен: {', '.join(v) if v else 'любой'}")
    flt = cfg_load().get("watch_filter", "mine+free")
    want_st = {s.lower() for s in cfg_load().get("watch_statuses", [])}
    st = state_load(); made_total = 0; lines = []; pending = []
    if args.prune:
        n = 0
        for slug in sorted(reg_load()):
            folder = reg_path(slug)
            tri = (folder / ".claude" / "триаж") if folder else None
            if not (tri and tri.is_dir()): continue
            c, p = api("GET", f"/projects/by_slug?slug={slug}")
            if c != 200: continue
            for fn in sorted(tri.glob("*.md")):
                txt = fn.read_text(errors="ignore")
                if "статус: ждёт разведки" not in txt: continue   # правленое не трогаем
                m = re.search(r"исполнитель: (.+)$", txt, re.M)
                who = (m.group(1).strip() if m else "")
                me = (IDENTITY.get("full_name_display") or IDENTITY.get("username") or "")
                ms = re.search(r"статус в трекере: (.+?) ·", txt)
                tracker_st = (ms.group(1).strip().lower() if ms else "")
                by_who = (who == me) or (flt == "mine+free" and who == "не назначена") or flt == "all"
                by_st = (not want_st) or (tracker_st in want_st)
                keep = by_who and by_st
                if not keep:
                    fn.unlink(); n += 1
                    ok(f"  убрано: {slug}/{fn.name[:42]}  ({who}, {tracker_st or '?'})")
        ok(f"\nубрано заготовок: {n} (отбор {flt}; правленые вручную не трогались)")
        return

    for slug in sorted(reg):
        folder = reg_path(slug)
        if not folder:
            continue                                   # папка исчезла — registry это покажет
        c, p = api("GET", f"/projects/by_slug?slug={slug}")
        if c != 200: lines.append(f"{slug}: проект недоступен ({c})"); continue
        pid = p["id"]
        last = None if args.days else st.get(slug, {}).get("last")
        since = (datetime.datetime.fromisoformat(last) if last
                 else datetime.datetime.now(datetime.timezone.utc)
                      - datetime.timedelta(days=int(args.days or 1)))
        now = datetime.datetime.now(datetime.timezone.utc)

        tri = folder / ".claude" / "триаж"
        existing = {f.name.split("-")[0] for f in tri.glob("*.md")} if tri.is_dir() else set()

        if want_st:
            have = set()
            for ep in ("userstory-statuses", "task-statuses", "issue-statuses"):
                c, ss = api("GET", f"/{ep}?project={pid}")
                have |= {s["name"].strip().lower() for s in (ss or [])}
            missing = sorted(want_st - have)
            if len(missing) == len(want_st):
                lines.append(f"{p['name']}: ни одного из заданных статусов нет в каталоге "
                             f"({', '.join(missing)}) — проект пропущен")
                continue
            if missing:
                lines.append(f"{p['name']}: нет статусов {', '.join(missing)} — учтены остальные")
        c, tks = api("GET", f"/tasks?project={pid}", nopage=True)
        kids = {}
        for k in (tks or []):
            if k.get("user_story"): kids.setdefault(k["user_story"], []).append(k)

        made = []
        for kind, ep in (("us","userstory-statuses"),("task","task-statuses"),("issue","issue-statuses")):
            c, stt = api("GET", f"/{ep}?project={pid}")
            closed_ids = {s["id"] for s in (stt or []) if s.get("is_closed")}
            c, items = api("GET", f"/{KINDS[kind][0]}?project={pid}", nopage=True)
            for o in (items or []):
                # Когда отбор по статусу задан, важна дата ИЗМЕНЕНИЯ: тикет мог
                # пролежать месяц и попасть в BUG сегодня. Без отбора — дата создания.
                stamp = o.get("modified_date") if want_st else o.get("created_date")
                if not stamp: continue
                if datetime.datetime.fromisoformat(stamp.replace("Z","+00:00")) < since: continue
                if str(o["ref"]) in existing: continue      # заготовка уже есть — не трогаем
                if o["status"] in closed_ids: continue      # закрытое разбирать незачем
                a = o.get("assigned_to")
                if flt == "mine" and a != IDENTITY["id"]: continue
                if flt == "mine+free" and a not in (IDENTITY["id"], None): continue
                if want_st:
                    nm = (o.get("status_extra_info") or {}).get("name", "").strip().lower()
                    if nm not in want_st: continue
                c, full = api("GET", f"/{KINDS[kind][0]}/{o['id']}")
                kd = any(len(((api("GET", f"/tasks/{k['id']}")[1] or {}).get("description") or "").strip()) >= 80
                         for k in kids.get(o["id"], [])) if kind == "us" else False
                flags = triage_item(o, full, kd, closed_ids)
                fn = tri / f"{o['ref']}-{_slugify(o['subject'])}.md"
                made.append((o["ref"], o["subject"], fn, stub_text(slug, p["name"], kind, o, full, flags, base())))

        if made:
            made_total += len(made)
            pending.append((slug, p["name"], tri, made, now))
            lines.append(f"{p['name']}: новых {len(made)} → {tri}")
            for ref, subj, _, _ in sorted(made, key=lambda x: x[0]):
                lines.append(f"    #{ref} {subj[:56]}")
        elif not args.dry:
            st[slug] = {"last": now.isoformat(), "folder": str(folder)}

    if made_total > int(args.max) and not args.dry:
        die(f"к созданию {made_total} заготовок — больше порога {args.max}.\n"
            f"       Так бывает при первом запуске или после массового импорта.\n"
            f"       Посмотрите `taiga watch --dry`, затем либо сузьте окно (--days),\n"
            f"       либо поднимите порог (--max). Отметка времени не сдвинута.")
    if not args.dry:                                   # запись только после предохранителя
        for slug, pname, tri, made, now in pending:
            tri.mkdir(parents=True, exist_ok=True)
            for ref, subj, fn, body in made: fn.write_text(body)
            st[slug] = {"last": now.isoformat(), "folder": str(tri.parent.parent)}
        state_save(st)
        # Подписки на бота живут в Telegram около суток: опрашиваем ежечасно,
        # иначе человек напишет боту ночью, а к утру факт исчезнет.
        if pathlib.Path(os.path.expanduser(cfg_load().get("telegram_token_file",
                                                          str(TG_TOKEN_FILE)))).is_file():
            if tg_busy():
                pass                      # слушатель уже читает за нас
            else:
                n, _ = tg_poll()
                if n: ok(f"новых подписок на бота: {n} (см. `taiga telegram --discover`)")
    if lines and not made_total:
        ok("\n".join(lines))                      # предупреждения не глотаем
    if made_total:
        ok("\n".join(lines))
        if not args.dry:
            notify("Taiga: новые задачи", f"Заготовок триажа: {made_total}. Спросите в проекте: что по триажу")
    else:
        ok("нового нет")
    if args.dry: ok("\n(сухой прогон — файлы не записаны, отметка времени не сдвинута)")

def main():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("-p","--project", help="слаг проекта (иначе из .claude/tracker.local.md)")
    common.add_argument("-y","--yes", action="store_true", help="не спрашивать подтверждения")
    common.add_argument("--kind", choices=list(KINDS), help="род единицы работы")
    ap = argparse.ArgumentParser(prog="taiga", description="работа с трекером Taiga из папки проекта")
    sub = ap.add_subparsers(dest="cmd", required=True); P = lambda n: sub.add_parser(n, parents=[common])
    lg = P("login"); lg.add_argument("--here", action="store_true", help="токен в .taiga/ этого проекта"); lg.set_defaults(fn=cmd_login)
    P("refresh").set_defaults(fn=cmd_refresh); P("status").set_defaults(fn=cmd_status); P("projects").set_defaults(fn=cmd_projects)
    i = P("init"); i.add_argument("slug"); i.add_argument("--name"); i.add_argument("--here", action="store_true"); i.add_argument("--force", action="store_true"); i.set_defaults(fn=cmd_init)
    l = P("ls"); l.add_argument("--open", action="store_true"); l.add_argument("--mine", action="store_true"); l.add_argument("--status"); l.set_defaults(fn=cmd_ls)
    s = P("show"); s.add_argument("ref"); s.set_defaults(fn=cmd_show)
    n = P("new"); n.add_argument("subject"); n.add_argument("--parent"); n.add_argument("--assign"); n.add_argument("--status")
    n.add_argument("--desc", help="описание; \\n разворачивается в перенос строки")
    n.add_argument("--desc-file", metavar="ФАЙЛ", help="описание из файла, как есть")
    n.add_argument("--force", action="store_true"); n.set_defaults(fn=cmd_new)
    m = P("mv"); m.add_argument("ref"); m.add_argument("status"); m.set_defaults(fn=cmd_mv)
    a = P("assign"); a.add_argument("ref"); a.add_argument("who"); a.set_defaults(fn=cmd_assign)
    np = P("new-project"); np.add_argument("name"); np.add_argument("--desc", required=True)
    np.add_argument("--public", action="store_true")
    np.add_argument("--sample", help="перенести колонки канбана из этого проекта")
    np.add_argument("--duplicate", help="создать дубликатом этого проекта: каталоги, роли,\nпроизвольные поля; спринты, задачи и участники НЕ копируются")
    np.add_argument("--modules", help="через запятую, по умолчанию epics,kanban")
    np.add_argument("--init", action="store_true", help="сразу подключить текущую папку")
    np.add_argument("--users", help="кого добавить, через запятую (отдельное подтверждение: уйдут письма)")
    np.add_argument("--role", help="роль добавляемых участников")
    np.set_defaults(fn=cmd_new_project)
    P("users").set_defaults(fn=cmd_users)
    rp = P("report"); rp.add_argument("--day", help="конкретная дата ГГГГ-ММ-ДД")
    rp.add_argument("--install", action="store_true", help="расписание: будни 09:00")
    rp.add_argument("--uninstall", action="store_true"); rp.add_argument("--quiet", action="store_true")
    rp.add_argument("--no-triage", action="store_true", help="без раздела триажа")
    rp.add_argument("--at", default="09:00", metavar="ЧЧ:ММ", help="время запуска, по умолчанию 09:00")
    rp.add_argument("--all-days", action="store_true", help="включая выходные")
    rp.add_argument("--set-dir", metavar="ПУТЬ", help="запомнить, куда складывать отчёты (и перенести прежние)")
    rp.set_defaults(fn=cmd_report)
    w = P("watch"); w.add_argument("--days", help="смотреть за N суток назад, игнорируя отметку времени")
    w.add_argument("--dry", action="store_true", help="показать, ничего не записывая")
    w.add_argument("--max", default="20", help="предохранитель: больше заготовок за раз не создавать")
    w.add_argument("--install", action="store_true", help="поставить расписание: 9–19 по будням")
    w.add_argument("--uninstall", action="store_true", help="снять расписание")
    w.add_argument("--every", default="1", metavar="Ч", help="период опроса в часах, по умолчанию 1")
    w.add_argument("--start", default="9", metavar="Ч", help="с какого часа, по умолчанию 9")
    w.add_argument("--end", default="19", metavar="Ч", help="по какой час, по умолчанию 19")
    w.add_argument("--all-days", action="store_true", help="включая выходные")
    w.add_argument("--filter", metavar="КТО", help="чьи тикеты брать: mine, mine+free, all (запоминается)")
    w.add_argument("--prune", action="store_true", help="убрать заготовки, не подходящие под отбор")
    w.add_argument("--statuses", metavar="СПИСОК",
                   help="какие статусы брать, через запятую; пусто — любые (запоминается)")
    w.set_defaults(fn=cmd_watch)
    dg = P("digest")
    dg.add_argument("--to", metavar="ИМЯ", help="сводка по конкретному человеку")
    dg.add_argument("--all", action="store_true", help="по всем получателям")
    dg.add_argument("--whoami", action="store_true", help="по себе")
    dg.add_argument("--evening", action="store_true", help="вечерний итог вместо утреннего плана")
    dg.add_argument("--send", action="store_true", help="отправить в Telegram, а не печатать")
    dg.add_argument("--install", action="store_true", help="расписание: будни, план утром, итог вечером")
    dg.add_argument("--uninstall", action="store_true")
    dg.add_argument("--at", default="08:30", metavar="ЧЧ:ММ", help="время утреннего плана")
    dg.add_argument("--evening-at", default="18:30", metavar="ЧЧ:ММ", help="время вечернего итога")
    dg.set_defaults(fn=cmd_digest)
    su = P("standup")
    su.add_argument("--day", help="конкретная дата ГГГГ-ММ-ДД, по умолчанию сегодня")
    su.add_argument("--only", metavar="ИМЯ", help="только по одному руководителю")
    su.add_argument("--pm-project", metavar="СЛАГ", help="проект с карточками дейликов")
    su.add_argument("--send", action="store_true", help="разослать руководителям в Telegram")
    su.add_argument("--install", action="store_true", help="расписание: будни 19:00")
    su.add_argument("--uninstall", action="store_true")
    su.add_argument("--at", default="19:00", metavar="ЧЧ:ММ", help="время запуска")
    su.set_defaults(fn=cmd_standup)
    nt = P("notify"); nt.add_argument("--dry", action="store_true", help="показать, не отправляя")
    nt.add_argument("--baseline", action="store_true",
                    help="пометить всё нынешнее как известное, ничего не отправляя")
    nt.add_argument("--max", default="15", help="предохранитель: больше за раз одному не слать")
    nt.add_argument("--install", action="store_true", help="расписание: ежечасно 9–19 по будням")
    nt.add_argument("--uninstall", action="store_true")
    nt.add_argument("--every", default="1", metavar="Ч", help="период опроса в часах")
    nt.add_argument("--start", default="9", metavar="Ч", help="с какого часа")
    nt.add_argument("--end", default="19", metavar="Ч", help="по какой час")
    nt.add_argument("--all-days", action="store_true", help="включая выходные")
    nt.add_argument("--column", metavar="КОЛОНКА",
                    help="следить за колонкой (например «Ready for test»); без --watchers — показать")
    nt.add_argument("--watchers", metavar="ИМЕНА",
                    help="кому слать про эту колонку, через запятую; пусто — только самоподписка")
    nt.add_argument("--off", action="store_true", help="с --column: перестать следить за колонкой")
    nt.set_defaults(fn=cmd_notify)
    rc = P("recon")
    rc.add_argument("--ref", help="только один тикет, не тратя дневной предел")
    rc.add_argument("--max-run", help="сколько тикетов за прогон, по умолчанию 3")
    rc.add_argument("--max-day", help="сколько тикетов в сутки, по умолчанию 10")
    rc.add_argument("--dry", action="store_true", help="показать, модель не запускать")
    rc.add_argument("--token", action="store_true",
                    help="ввести долгоживущий токен от `claude setup-token`")
    rc.add_argument("--send", action="store_true", help="разослать итог в Telegram")
    rc.add_argument("--install", action="store_true", help="расписание: будни, каждые 2 ч")
    rc.add_argument("--uninstall", action="store_true")
    rc.add_argument("--every", default="2", metavar="Ч", help="период, по умолчанию 2 ч")
    rc.add_argument("--start", default="9", metavar="Ч")
    rc.add_argument("--end", default="19", metavar="Ч")
    rc.set_defaults(fn=cmd_recon)
    rt = P("rituals")
    rt.add_argument("--week", help="любая дата нужной недели, ГГГГ-ММ-ДД")
    rt.add_argument("--managers", metavar="ИМЕНА", help="через запятую (запоминается)")
    rt.add_argument("--dry", action="store_true", help="показать, ничего не создавая")
    rt.add_argument("--install", action="store_true", help="расписание: понедельник 08:00")
    rt.add_argument("--uninstall", action="store_true")
    rt.set_defaults(fn=cmd_rituals)
    tg = P("telegram")
    tg.add_argument("--discover", action="store_true", help="кто писал боту: имена и chat_id")
    tg.add_argument("--add", nargs=2, metavar=("ИМЯ","CHAT_ID"), help="связать человека с чатом")
    tg.add_argument("--remove", metavar="ИМЯ", help="убрать получателя")
    tg.add_argument("--test", action="store_true", help="отправить всем проверочное сообщение")
    tg.add_argument("--poll", action="store_true", help="разобрать накопившееся и выйти")
    tg.add_argument("--serve", action="store_true", help="слушать бота постоянно (длинный опрос)")
    tg.add_argument("--install", action="store_true", help="частый опрос бота (ради кнопок)")
    tg.add_argument("--uninstall", action="store_true")
    tg.add_argument("--every-sec", default="120", metavar="СЕК", help="период опроса, по умолчанию 120")
    tg.set_defaults(fn=cmd_telegram)
    rg = P("registry"); rg.add_argument("--forget", metavar="СЛАГ", help="убрать проект из реестра")
    rg.add_argument("--scan", nargs="?", const="", metavar="ПУТЬ",
                    help="найти уже подключённые проекты и внести в реестр")
    rg.set_defaults(fn=cmd_registry)
    tr = P("triage"); tr.add_argument("--days", default="1", help="за сколько суток, по умолчанию 1")
    tr.add_argument("--comment", action="store_true", help="оставить замечания комментарием в трекере")
    tr.add_argument("--all", action="store_true", help="по всем доступным проектам")
    tr.set_defaults(fn=cmd_triage)
    sy = P("sync"); sy.add_argument("--ref", help="только одна история")
    sy.add_argument("--dry", action="store_true", help="только показать расхождения")
    sy.set_defaults(fn=cmd_sync)
    pl = P("plan"); pl.add_argument("file"); pl.set_defaults(fn=cmd_plan)
    apl = P("apply"); apl.add_argument("file"); apl.set_defaults(fn=cmd_apply)
    cm = P("comment"); cm.add_argument("ref"); cm.add_argument("text"); cm.add_argument("--force", action="store_true"); cm.set_defaults(fn=cmd_comment)
    args = ap.parse_args(); args.fn(args)

if __name__ == "__main__":
    try: main()
    except KeyboardInterrupt: sys.exit(130)
